---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import profile from '../data/profile.json';
import academic from '../data/academic.json';
import projects from '../data/projects.json';

const totalSubjects = academic.reduce((acc, c) => acc + c.groups.reduce((gAcc, g) => gAcc + g.subjects.length, 0), 0);
---

<Layout>
  <Header activeTab="home" />

  <main class="max-w-5xl mx-auto px-6 pt-16 sm:pt-24 pb-12">
    <!-- Hero Editorial estilo Daniel Sun -->
    <section class="max-w-3xl">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-[#6e6e76] mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>UGR · Doble Grado en Informática & ADE</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-medium tracking-tight text-[#111113] leading-[1.25]">
        Hola, soy Javier Checa. Estudio <span class="font-serif-italic font-normal text-[1.12em] tracking-normal">Ingeniería Informática</span> y <span class="font-serif-italic font-normal text-[1.12em] tracking-normal">ADE</span> en Granada, combinando desarrollo de software, optimización y visión estratégica.
      </h1>

      <p class="mt-8 text-base sm:text-lg text-[#6e6e76] leading-relaxed max-w-2xl">
        Este espacio funciona como mi portfolio personal y biblioteca abierta: aquí documento tanto mi trayectoria y recursos universitarios como el código de mis proyectos personales.
      </p>
    </section>

    <!-- Las Dos Subdivisiones Principales -->
    <section class="mt-20 pt-12 border-t border-[#eaeaea]">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- SUBDIVISIÓN 1: GRADO UNIVERSITARIO -->
        <a
          href="/universidad"
          class="group block p-8 rounded-2xl border border-[#eaeaea] hover:border-black bg-white hover:bg-[#fafafc] transition-all duration-200"
        >
          <div class="flex items-center justify-between text-xs font-mono text-[#8a8a93] mb-6">
            <span>01 / ACADÉMICO</span>
            <span class="text-[#111113] font-semibold">6 Etapas · {totalSubjects} Asignaturas</span>
          </div>

          <h2 class="text-2xl font-semibold text-[#111113] group-hover:text-black tracking-tight">
            Grado <span class="font-serif-italic font-normal text-[1.1em]">Universitario</span>
          </h2>

          <p class="mt-3 text-sm text-[#6e6e76] leading-relaxed">
            Plan de estudios estructurado en 6 etapas: 1º, 2º y 3º en la UGR, año Erasmus en Atenas, año SICUE en Valencia y 6º curso de finalización. Incluye guías docentes oficiales y recursos.
          </p>

          <!-- Timeline mini resumen -->
          <div class="mt-6 pt-5 border-t border-[#f0f0f2] flex flex-wrap gap-2 text-[11px] font-mono text-[#6e6e76]">
            <span class="px-2 py-0.5 rounded bg-[#f5f5f7]">1º UGR</span>
            <span class="px-2 py-0.5 rounded bg-[#f5f5f7]">2º UGR</span>
            <span class="px-2 py-0.5 rounded bg-[#f5f5f7]">3º UGR</span>
            <span class="px-2 py-0.5 rounded bg-[#f5f5f7]">Erasmus Atenas</span>
            <span class="px-2 py-0.5 rounded bg-[#f5f5f7]">SICUE Valencia</span>
            <span class="px-2 py-0.5 rounded bg-[#f5f5f7]">6º Final</span>
          </div>

          <div class="mt-6 flex items-center gap-1.5 text-xs font-semibold text-[#111113] group-hover:translate-x-1 transition-transform">
            <span>Acceder al plan de estudios y apuntes</span>
            <span aria-hidden="true">→</span>
          </div>
        </a>

        <!-- SUBDIVISIÓN 2: PROYECTOS PERSONALES -->
        <a
          href="/proyectos"
          class="group block p-8 rounded-2xl border border-[#eaeaea] hover:border-black bg-white hover:bg-[#fafafc] transition-all duration-200"
        >
          <div class="flex items-center justify-between text-xs font-mono text-[#8a8a93] mb-6">
            <span>02 / SOFTWARE</span>
            <span class="text-[#111113] font-semibold">{projects.length} Proyectos catalogados</span>
          </div>

          <h2 class="text-2xl font-semibold text-[#111113] group-hover:text-black tracking-tight">
            Proyectos <span class="font-serif-italic font-normal text-[1.1em]">Personales</span>
          </h2>

          <p class="mt-3 text-sm text-[#6e6e76] leading-relaxed">
            Desarrollo de software, algoritmos de optimización con Google OR-Tools CP-SAT, aplicaciones de escritorio en Qt, simuladores interactivos de estrategia y análisis cuantitativo.
          </p>

          <!-- Tags destacados -->
          <div class="mt-6 pt-5 border-t border-[#f0f0f2] flex flex-wrap gap-2 text-[11px] font-mono text-[#6e6e76]">
            <span class="px-2 py-0.5 rounded bg-[#f5f5f7]">Planificador Hospitalario</span>
            <span class="px-2 py-0.5 rounded bg-[#f5f5f7]">CP-SAT</span>
            <span class="px-2 py-0.5 rounded bg-[#f5f5f7]">PySide / Qt</span>
            <span class="px-2 py-0.5 rounded bg-[#f5f5f7]">Estrategia ADE</span>
          </div>

          <div class="mt-6 flex items-center gap-1.5 text-xs font-semibold text-[#111113] group-hover:translate-x-1 transition-transform">
            <span>Ver listado de proyectos</span>
            <span aria-hidden="true">→</span>
          </div>
        </a>

      </div>
    </section>

    <!-- Breve Nota de Contacto estilo Daniel Sun -->
    <section class="mt-20 pt-12 border-t border-[#eaeaea] flex flex-col sm:flex-row sm:items-baseline justify-between gap-6">
      <div>
        <h3 class="text-base font-semibold text-[#111113]">
          Contacto & Colaboración
        </h3>
        <p class="mt-1 text-xs sm:text-sm text-[#6e6e76]">
          Abierto a intercambiar ideas sobre software, optimización o el doble grado.
        </p>
      </div>

      <div class="flex items-center gap-6 text-xs sm:text-sm font-medium">
        <a href={profile.links.email} class="text-[#111113] hover:underline">
          javicheca2003@gmail.com
        </a>
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer" class="text-[#6e6e76] hover:text-black">
          github.com/{profile.handle}
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
