---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BentoGrid from '../components/BentoGrid.astro';
import Footer from '../components/Footer.astro';
import profile from '../data/profile.json';
---

<Layout>
  <Header />

  <main>
    <BentoGrid />

    <!-- Sección de Contacto Directo en Bento -->
    <section class="max-w-6xl mx-auto px-4 mt-8">
      <div class="backdrop-blur-xl bg-gradient-to-br from-emerald-500/10 via-slate-100/50 to-indigo-500/10 dark:from-emerald-950/20 dark:via-[#0c121e]/85 dark:to-indigo-950/20 border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-8 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 font-mono">
            Contacto & Colaboración
          </span>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-1">
            ¿Hablamos sobre algún proyecto o idea?
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2 max-w-xl">
            Siempre dispuesto a colaborar en desarrollo de software, algoritmos de optimización, proyectos open-source o retos del Doble Grado.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a
            href={profile.links.email}
            class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs sm:text-sm font-semibold shadow-md shadow-emerald-500/20 transition-all whitespace-nowrap"
          >
            Enviar Mensaje
          </a>
          <a
            href={profile.links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-700 transition-all whitespace-nowrap"
          >
            GitHub
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
