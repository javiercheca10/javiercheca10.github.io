---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';

marked.setOptions({
  gfm: true,
  breaks: true,
});

const docs = [
  {
    id: "fs-bash-guia",
    titulo: "Prácticas de Shell Scripting & Administración del Sistema",
    tipo: "GUÍA & SCRIPTS",
    isPdf: false,
    badgeColor: "bg-blue-100 text-blue-900 border-blue-300",
    path: "public/subjects/FS/practicas_shell_bash_scripts.md",
    downloadUrl: "/subjects/FS/practicas_shell_bash_scripts.md",
    downloadLabel: "Descargar Guía (MD)",
    resumen: "Compendio de prácticas en GNU/Linux Bash: control de flujo estructurado, análisis de rutas con test, bucles interactivos for/while y filtrado temporal de inodos con find."
  },
  {
    id: "fs-script-guion",
    titulo: "guion_practica_bash.sh · Script de Análisis de Directorios",
    tipo: "SCRIPT BASH",
    isPdf: false,
    badgeColor: "bg-emerald-100 text-emerald-900 border-emerald-300",
    downloadUrl: "/subjects/FS/guion_practica_bash.sh",
    downloadLabel: "Descargar guion_practica_bash.sh",
    resumen: "Script interactivo de 4 fases para validar rutas de directorios, conteo por tipo de archivo, comprobación de paridad y redirección con head."
  },
  {
    id: "fs-script-find",
    titulo: "practica3_4_find_atime.sh · Auditoría de Acceso Temporal",
    tipo: "SCRIPT BASH",
    isPdf: false,
    badgeColor: "bg-emerald-100 text-emerald-900 border-emerald-300",
    downloadUrl: "/subjects/FS/practica3_4_find_atime.sh",
    downloadLabel: "Descargar practica3_4_find_atime.sh",
    resumen: "Automatización de búsqueda mediante find con filtrado por marca de tiempo de acceso (-atime)."
  }
];

const renderedDocs = docs.map(doc => {
  if (doc.isPdf || !doc.path) {
    return {
      ...doc,
      html: ""
    };
  }
  const fullPath = path.join(process.cwd(), doc.path);
  let raw = "";
  if (fs.existsSync(fullPath)) {
    raw = fs.readFileSync(fullPath, 'utf-8');
  } else {
    raw = `*Generando documento: ${doc.titulo}... Por favor refresca la página.*`;
  }
  return {
    ...doc,
    html: marked.parse(raw)
  };
});
---

<Layout
  title="Recursos · Fundamentos del Software (FS) | Javier Checa"
  description="Prácticas de shell scripting en Bash y administración de sistemas GNU/Linux para el Doble Grado Informática + ADE UGR."
>
  <Header activeTab="universidad" />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <!-- Migas de pan y cabecera técnica -->
    <div class="border-b border-[#18181b] pb-4 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs">
      <div class="flex items-center gap-2 text-[#52525b]">
        <a href="/universidad" class="hover:text-black font-bold">[UNIVERSIDAD]</a>
        <span>/</span>
        <span>1º CURSO (UGR)</span>
        <span>/</span>
        <span class="text-[#09090b] font-bold">FS</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="px-2 py-0.5 bg-[#f4f4f5] border border-[#d4d4d8] text-[#09090b]">
          GRADO INFORMÁTICA + ADE
        </span>
        <span class="px-2 py-0.5 bg-[#18181b] text-white font-bold">
          6 ECTS
        </span>
      </div>
    </div>

    <!-- Título principal -->
    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <span class="px-2.5 py-1 bg-emerald-100 text-emerald-900 border border-emerald-300 font-mono text-xs font-bold">
          SHELL SCRIPTING & LINUX
        </span>
        <span class="text-xs font-mono text-[#71717a]">CÓDIGO: FS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#09090b]">
        Fundamentos del Software
      </h1>
      <p class="text-[#52525b] mt-2 max-w-3xl text-sm sm:text-base leading-relaxed">
        Arquitectura y servicios del sistema operativo, llamadas al sistema, administración de ficheros y directorios, expresiones regulares, tuberías y scripts de automatización en Bash.
      </p>
    </div>

    <!-- Pestañas de Documentos -->
    <div class="flex flex-wrap gap-2 mb-6 border-b border-[#e4e4e7] pb-3 font-mono text-xs">
      {docs.map((doc, idx) => (
        <button
          class={`tab-btn px-3 py-1.5 border transition-all flex items-center gap-2 font-medium ${
            idx === 0
              ? 'bg-[#18181b] text-white border-[#18181b]'
              : 'bg-white text-[#52525b] border-[#d4d4d8] hover:border-black'
          }`}
          data-doc-id={doc.id}
        >
          <span>🖥️ {doc.titulo.split('·')[0]}</span>
          <span class={`text-[10px] px-1.5 py-0.2 border rounded ${doc.badgeColor}`}>
            {doc.tipo}
          </span>
        </button>
      ))}
    </div>

    <!-- Contenedores de cada Documento -->
    {renderedDocs.map((doc, idx) => (
      <div id={`container-${doc.id}`} class={`doc-container ${idx === 0 ? 'block' : 'hidden'}`}>
        <!-- Metadatos del documento activo -->
        <div class="border border-[#18181b] bg-white p-4 sm:p-5 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs shadow-sm">
          <div>
            <div class="flex items-center gap-2">
              <span class={`px-2 py-0.5 border font-bold text-[11px] rounded ${doc.badgeColor}`}>
                {doc.tipo}
              </span>
              <h2 class="font-bold text-[#09090b] text-sm sm:text-base">
                {doc.titulo}
              </h2>
            </div>
            <p class="text-[#52525b] mt-1 font-sans text-xs">
              {doc.resumen}
            </p>
          </div>

          <a
            href={doc.downloadUrl}
            download
            class="px-4 py-2 border border-[#18181b] bg-[#18181b] text-white hover:bg-[#27272a] transition-colors font-bold whitespace-nowrap flex items-center gap-2 self-start sm:self-auto text-xs shadow-sm"
          >
            <span>{doc.downloadLabel || "Descargar Archivo"}</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>

        <article
          class="prose-custom border border-[#18181b] bg-white p-6 sm:p-10 text-[#09090b] leading-relaxed shadow-sm"
          set:html={doc.html}
        />
      </div>
    ))}

    <!-- Banner inferior de navegación -->
    <div class="mt-8 pt-4 border-t border-[#18181b] flex items-center justify-between font-mono text-xs text-[#52525b]">
      <span>Documentación y prácticas de laboratorio de Fundamentos del Software.</span>
      <a href="/universidad" class="hover:text-black font-bold">
        ← Volver al Plan de Estudios
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const tabs = document.querySelectorAll('.tab-btn');
  const containers = document.querySelectorAll('.doc-container');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const docId = tab.dataset.docId;

      tabs.forEach(t => {
        t.classList.remove('bg-[#18181b]', 'text-white', 'border-[#18181b]');
        t.classList.add('bg-white', 'text-[#52525b]', 'border-[#d4d4d8]');
      });
      tab.classList.add('bg-[#18181b]', 'text-white', 'border-[#18181b]');
      tab.classList.remove('bg-white', 'text-[#52525b]');

      containers.forEach(c => {
        c.classList.add('hidden');
        c.classList.remove('block');
      });

      const activeContainer = document.getElementById(`container-${docId}`);
      if (activeContainer) {
        activeContainer.classList.remove('hidden');
        activeContainer.classList.add('block');
      }
    });
  });
</script>

<style is:global>
  .prose-custom h1 {
    font-size: 1.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #18181b;
  }
  .prose-custom h2 {
    font-size: 1.2rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid #e4e4e7;
  }
  .prose-custom h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #18181b;
  }
  .prose-custom p {
    margin-bottom: 1rem;
    font-size: 0.925rem;
    line-height: 1.7;
    color: #27272a;
  }
  .prose-custom ul, .prose-custom ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    font-size: 0.925rem;
  }
  .prose-custom li {
    margin-bottom: 0.35rem;
  }
  .prose-custom strong {
    color: #09090b;
    font-weight: 700;
  }
  .prose-custom pre {
    background-color: #18181b;
    color: #f4f4f5;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
  }
  .prose-custom code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.85em;
  }
</style>
