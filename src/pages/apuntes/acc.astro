---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';

marked.setOptions({
  gfm: true,
  breaks: true,
});

const docs = [
  {
    id: "acerinox-analisis",
    titulo: "Análisis Económico-Financiero: Acerinox Europa (Memoria)",
    tipo: "ANÁLISIS FINANCIERO",
    isPdf: false,
    badgeColor: "bg-blue-100 text-blue-900 border-blue-300",
    path: "public/subjects/ACC/analisis_financiero_acerinox.md",
    downloadUrl: "/subjects/ACC/analisis_financiero_acerinox.md",
    downloadLabel: "Descargar Análisis (MD)",
    pdfAttachmentUrl: "/subjects/ACC/analisis_economico_financiero_acerinox.pdf",
    pdfAttachmentLabel: "Descargar Informe Original (PDF 425 KB)",
    resumen: "Diagnóstico patrimonial, Fondo de Maniobra, liquidez, solvencia, estado de origen y aplicación de fondos (EOAF), rentabilidad económica (ROA) y financiera (ROE Parés) de Acerinox Europa S.A.U."
  },
  {
    id: "acerinox-pdf",
    titulo: "Acerinox Europa S.A.U. · Informe Oficial (PDF)",
    tipo: "INFORME MAQUETADO PDF",
    isPdf: true,
    badgeColor: "bg-purple-100 text-purple-900 border-purple-300",
    downloadUrl: "/subjects/ACC/analisis_economico_financiero_acerinox.pdf",
    downloadLabel: "Descargar PDF (425 KB)",
    resumen: "Memoria completa de 12 páginas con tablas de estados financieros comparativos 2022-2023, gráficos de balances y ratios sectoriales frente a competidores siderúrgicos."
  },
  {
    id: "acerinox-excel",
    titulo: "Modelo Financiero y Ratios · Hoja de Cálculo (Excel)",
    tipo: "MODELO EXCEL .XLSX",
    isPdf: false,
    badgeColor: "bg-emerald-100 text-emerald-900 border-emerald-300",
    downloadUrl: "/subjects/ACC/acerinox_modelo_financiero.xlsx",
    downloadLabel: "Descargar Excel (.XLSX 121 KB)",
    resumen: "Libro de cálculo interactivo en Microsoft Excel con el balance ordenado, cuenta de pérdidas y ganancias analítica, pirámide de ratios de DuPont/Parés y gráficos dinámicos."
  }
];

const renderedDocs = docs.map(doc => {
  if (doc.isPdf || !doc.path) {
    return {
      ...doc,
      html: ""
    };
  }
  const fullPath = path.join(process.cwd(), doc.path);
  let raw = "";
  if (fs.existsSync(fullPath)) {
    raw = fs.readFileSync(fullPath, 'utf-8');
  } else {
    raw = `*Generando documento: ${doc.titulo}... Por favor refresca la página.*`;
  }
  return {
    ...doc,
    html: marked.parse(raw)
  };
});
---

<Layout
  title="ACC · Análisis y Consolidación Contable | Javier Checa"
  description="Análisis y Consolidación Contable (SICUE · UPV): Análisis económico-financiero de Acerinox Europa S.A.U., solvencia, fondo de maniobra, ROA y descomposición de ROE."
>
  <Header activeTab="universidad" />

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <!-- Migas de pan -->
    <div class="border-b border-[#18181b] pb-4 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs">
      <div class="flex items-center gap-2 text-[#52525b]">
        <a href="/universidad" class="hover:text-black font-bold">[UNIVERSIDAD]</a>
        <span>/</span>
        <span>SICUE · VALENCIA</span>
        <span>/</span>
        <span class="text-[#09090b] font-bold">ACC · ANÁLISIS Y CONSOLIDACIÓN CONTABLE</span>
      </div>

      <a
        href="/universidad#stage-sicue-valencia"
        class="px-3 py-1.5 bg-[#18181b] text-white hover:bg-black transition-colors font-bold w-fit"
      >
        ← Volver a Asignaturas
      </a>
    </div>

    <!-- Título de la Asignatura -->
    <div class="mb-8">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-[#52525b] mb-1">
        <span>[ RECURSOS SICUE · UPV ]</span>
        <span>•</span>
        <span class="text-emerald-700 font-bold">AUDITORÍA & FINANZAS</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#09090b] tracking-tight mb-2">
        Análisis y Consolidación Contable
      </h1>
      <p class="text-sm sm:text-base text-[#52525b] max-w-3xl">
        Auditoría analítica y diagnóstico económico-financiero de sociedades mercantiles y grupos consolidados: reordenación funcional del balance, equilibrio financiero a corto y largo plazo (NOF y Fondo de Maniobra), estados de flujos de efectivo y descomposición factorial de la rentabilidad (DuPont y Parés).
      </p>
    </div>

    <!-- Selector de Documentos / Pestañas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-8">
      {docs.map((doc, idx) => (
        <button
          class={`doc-tab text-left p-4 border transition-all flex flex-col justify-between ${idx === 0 ? 'border-black bg-zinc-50 shadow-sm ring-1 ring-black' : 'border-[#e4e4e7] hover:border-zinc-400 bg-white'}`}
          data-target={doc.id}
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class={`text-[10px] font-mono px-2 py-0.5 border font-semibold ${doc.badgeColor}`}>
                {doc.tipo}
              </span>
              <span class="text-[11px] font-mono text-[#71717a]">DOC #{idx + 1}</span>
            </div>
            <h3 class="font-bold text-sm text-[#09090b] leading-snug mb-1">
              {doc.titulo}
            </h3>
            <p class="text-xs text-[#52525b] line-clamp-2">
              {doc.resumen}
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-zinc-100 flex items-center justify-between text-[11px] font-mono text-zinc-600">
            <span>{doc.isPdf ? 'Visor PDF Embebido' : 'Documento / Hoja'}</span>
            <span class="font-bold">Ver →</span>
          </div>
        </button>
      ))}
    </div>

    <!-- Visor de Documentos -->
    <div class="bg-white border border-[#18181b] shadow-sm">
      {renderedDocs.map((doc, idx) => (
        <article
          id={`content-${doc.id}`}
          class={`doc-content p-6 sm:p-10 ${idx === 0 ? 'block' : 'hidden'}`}
        >
          <header class="border-b border-[#e4e4e7] pb-6 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <span class={`inline-block text-[10px] font-mono px-2 py-0.5 border font-semibold mb-2 ${doc.badgeColor}`}>
                {doc.tipo}
              </span>
              <h2 class="text-xl sm:text-2xl font-bold text-[#09090b]">
                {doc.titulo}
              </h2>
              <p class="text-xs text-[#52525b] font-mono mt-1">
                {doc.resumen}
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              {doc.downloadUrl && (
                <a
                  href={doc.downloadUrl}
                  download
                  class="px-3 py-1.5 bg-[#18181b] text-white hover:bg-black transition-colors font-mono text-xs font-bold inline-flex items-center gap-1.5 shadow-sm"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                  {doc.downloadLabel || 'Descargar'}
                </a>
              )}
              {doc.pdfAttachmentUrl && (
                <a
                  href={doc.pdfAttachmentUrl}
                  download
                  class="px-3 py-1.5 bg-zinc-100 hover:bg-zinc-200 text-zinc-900 border border-zinc-300 transition-colors font-mono text-xs font-bold inline-flex items-center gap-1.5"
                >
                  <svg class="w-3.5 h-3.5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
                  </svg>
                  {doc.pdfAttachmentLabel || 'PDF Original'}
                </a>
              )}
            </div>
          </header>

          {doc.isPdf ? (
            <div class="space-y-4">
              <div class="w-full h-[750px] border border-zinc-300 rounded bg-zinc-100 overflow-hidden shadow-inner">
                <iframe
                  src={doc.downloadUrl}
                  class="w-full h-full border-0"
                  title={doc.titulo}
                />
              </div>
            </div>
          ) : doc.path ? (
            <div class="prose prose-zinc max-w-none text-[#27272a] text-sm leading-relaxed prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-black prose-h1:text-xl prose-h2:text-lg prose-h3:text-base prose-pre:bg-zinc-900 prose-pre:text-zinc-100 prose-table:border prose-table:border-zinc-200">
              <Fragment set:html={doc.html} />
            </div>
          ) : (
            <div class="p-8 border border-zinc-200 bg-zinc-50 text-center rounded space-y-4">
              <div class="w-12 h-12 mx-auto bg-emerald-100 text-emerald-800 rounded-full flex items-center justify-center font-bold text-xl">
                📊
              </div>
              <h3 class="text-base font-bold text-zinc-900">Modelo Financiero Acerinox Europa S.A.U. (.XLSX)</h3>
              <p class="text-xs text-zinc-600 max-w-md mx-auto">
                Archivo de cálculo completo con las tablas de balance reordenado, cuenta de pérdidas y ganancias, estados de flujos y formulación automatizada de ratios.
              </p>
              <div>
                <a
                  href={doc.downloadUrl}
                  download
                  class="px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white font-mono text-xs font-bold inline-flex items-center gap-2 rounded shadow"
                >
                  Descargar Libro Excel (121 KB)
                </a>
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.doc-tab');
    const contents = document.querySelectorAll('.doc-content');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-target');

        tabs.forEach(t => {
          t.classList.remove('border-black', 'bg-zinc-50', 'shadow-sm', 'ring-1', 'ring-black');
          t.classList.add('border-[#e4e4e7]', 'bg-white');
        });

        tab.classList.add('border-black', 'bg-zinc-50', 'shadow-sm', 'ring-1', 'ring-black');
        tab.classList.remove('border-[#e4e4e7]', 'bg-white');

        contents.forEach(content => {
          if (content.id === `content-${targetId}`) {
            content.classList.remove('hidden');
            content.classList.add('block');
          } else {
            content.classList.remove('block');
            content.classList.add('hidden');
          }
        });

        if (window.renderMathInElement) {
          window.renderMathInElement(document.body, {
            delimiters: [
              { left: '$$', right: '$$', display: true },
              { left: '$', right: '$', display: false }
            ],
            throwOnError: false
          });
        }
      });
    });

    if (window.renderMathInElement) {
      window.renderMathInElement(document.body, {
        delimiters: [
          { left: '$$', right: '$$', display: true },
          { left: '$', right: '$', display: false }
        ],
        throwOnError: false
      });
    }
  });
</script>
