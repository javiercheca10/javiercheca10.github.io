---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';

marked.setOptions({
  gfm: true,
  breaks: true,
});

const docs = [
  {
    id: "practica-irrgarten",
    titulo: "Proyecto Práctico: Videojuego Irrgarten",
    tipo: "PROYECTO SOFTWARE",
    badgeColor: "bg-emerald-100 text-emerald-900 border-emerald-300",
    isExternal: true,
    githubUrl: "https://github.com/MatthewHN/PDOO",
    resumen: "Juego por turnos de exploración y combate en laberinto implementado en Java y Ruby. Aplica principios avanzados de POO: herencia y polimorfismo (LabyrinthCharacter, Player, Monster, FuzzyPlayer), gestión dinámica de inventario (armas y escudos con barajas finitas), interfaz desacoplada bajo arquitectura MVC y soporte para consola (TextUI) e interfaz gráfica (Swing/GraphicUI)."
  },
  {
    id: "cuestionario-teoria",
    titulo: "Cuestionario de Teoría y Fundamentos",
    tipo: "TEST RESUELTO",
    badgeColor: "bg-blue-100 text-blue-900 border-blue-300",
    path: "public/subjects/PDOO/cuestionario_teoria_pdoo.md",
    downloadUrl: "/subjects/PDOO/cuestionario_teoria_pdoo.md",
    resumen: "Preguntas de verdadero y falso con justificación exhaustiva sobre identidad de objetos, dirección de memoria vs estado, variables de clase, constructores, métodos de clase/instancia, visibilidad (package, private, public) y peculiaridades de Java frente a Ruby."
  },
  {
    id: "resumen-conceptos",
    titulo: "Resumen: Atributos, Encapsulamiento y Constructores",
    tipo: "TEORÍA COMPARADA",
    badgeColor: "bg-purple-100 text-purple-900 border-purple-300",
    path: "public/subjects/PDOO/resumen_conceptos_clave.md",
    downloadUrl: "/subjects/PDOO/resumen_conceptos_clave.md",
    resumen: "Esquema sintáctico y conceptual: modificadores final/private, uso del puntero this, ocultación de información mediante paquetes en Java vs módulos en Ruby, y constructores sobrecargados / initialize."
  },
  {
    id: "jerarquia-uml",
    titulo: "Jerarquía y Taxonomía de Clases en Java (UML)",
    tipo: "DIAGRAMAS UML",
    badgeColor: "bg-amber-100 text-amber-900 border-amber-300",
    path: "public/subjects/PDOO/jerarquia_clases_java_uml.md",
    downloadUrl: "/subjects/PDOO/jerarquia_clases_java_uml.md",
    resumen: "Diagrama de clases UML con definiciones técnicas rigurosas de la taxonomía de clases: Clases Abstractas, Clases Concretas, Clases Hoja y Clases No Hoja, analizando sus restricciones de instanciación y herencia."
  }
];

const renderedDocs = docs.map(doc => {
  if (doc.isExternal) {
    return {
      ...doc,
      html: ""
    };
  }
  const fullPath = path.join(process.cwd(), doc.path);
  let raw = "";
  if (fs.existsSync(fullPath)) {
    raw = fs.readFileSync(fullPath, 'utf-8');
  } else {
    raw = `*Generando documento: ${doc.titulo}... Por favor refresca la página.*`;
  }
  return {
    ...doc,
    html: marked.parse(raw)
  };
});
---

<Layout
  title="PDOO · Programación y Diseño Orientado a Objetos | Javier Checa"
  description="Cuaderno digitalizado y proyecto práctico de Programación y Diseño Orientado a Objetos (UGR): Práctica Irrgarten (Java/Ruby), Cuestionarios y Diagramas UML."
>
  <Header activeTab="universidad" />

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <!-- Migas de pan y cabecera técnica -->
    <div class="border-b border-[#18181b] pb-4 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs">
      <div class="flex items-center gap-2 text-[#52525b]">
        <a href="/universidad" class="hover:text-black font-bold">[UNIVERSIDAD]</a>
        <span>/</span>
        <span>2º CURSO</span>
        <span>/</span>
        <span class="text-[#09090b] font-bold">PDOO · PROGRAMACIÓN Y DISEÑO ORIENTADO A OBJETOS</span>
      </div>

      <a
        href="/universidad#stage-2-curso"
        class="px-3 py-1.5 bg-[#18181b] text-white hover:bg-black transition-colors font-bold w-fit"
      >
        ← Volver a Asignaturas
      </a>
    </div>

    <!-- Título de la Asignatura -->
    <div class="mb-8">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-[#52525b] mb-1">
        <span>[ ARCHIVO DIGITALIZADO & PROYECTO SOFTWARE ]</span>
        <span>//</span>
        <span>ETSIIT · UNIVERSIDAD DE GRANADA</span>
      </div>
      <h1 class="text-3xl font-extrabold uppercase tracking-tight text-[#09090b]">
        Programación y Diseño Orientado a Objetos (PDOO)
      </h1>
      <p class="text-xs sm:text-sm text-[#52525b] mt-2">
        Apuntes técnicos, cuestionarios teóricos evaluados, taxonomías de herencia UML y el repositorio oficial de la práctica <em>Irrgarten</em> (Java / Ruby).
      </p>
    </div>

    <!-- Selector de Documentos (Pestañas) -->
    <div class="border border-[#18181b] bg-[#f4f4f5] p-2 mb-8 flex flex-wrap gap-1.5 font-mono text-xs" id="doc-tabs">
      {renderedDocs.map((doc, idx) => (
        <button
          data-doc-id={doc.id}
          class={`doc-tab px-3 py-2 text-left font-bold border transition-colors flex items-center justify-between gap-3 ${idx === 0 ? 'bg-[#18181b] text-white border-[#18181b]' : 'bg-white text-[#52525b] hover:text-black border-[#d4d4d8] hover:border-[#18181b]'}`}
        >
          <span>{doc.isExternal ? '🎮' : '📁'} {doc.titulo}</span>
          <span class={`text-[10px] px-1.5 py-0.2 border ${doc.badgeColor}`}>
            {doc.tipo}
          </span>
        </button>
      ))}
    </div>

    <!-- Contenedores de Documentos -->
    {renderedDocs.map((doc, idx) => (
      <div
        id={`doc-content-${doc.id}`}
        class={`doc-pane ${idx === 0 ? 'block' : 'hidden'}`}
      >
        <!-- Ficha técnica del documento activo -->
        <div class="border border-[#18181b] bg-[#f4f4f5] p-5 mb-6 font-mono text-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-[#09090b] uppercase">{doc.titulo}</span>
              <span class={`px-2 py-0.5 border text-[10px] font-bold ${doc.badgeColor}`}>
                {doc.tipo}
              </span>
            </div>
            <p class="text-[#52525b] max-w-2xl leading-relaxed">{doc.resumen}</p>
          </div>

          <div class="flex items-center gap-2">
            {doc.isExternal ? (
              <a
                href={doc.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 bg-[#18181b] text-white hover:bg-black transition-colors font-bold flex items-center gap-1.5"
              >
                <span>Ver Código en GitHub</span>
                <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <a
                href={doc.downloadUrl}
                download
                class="px-3 py-1.5 bg-white border border-[#18181b] hover:bg-[#18181b] hover:text-white transition-colors font-bold flex items-center gap-1.5"
              >
                <span>📥 Descargar Markdown</span>
              </a>
            )}
          </div>
        </div>

        {doc.isExternal ? (
          <div class="border border-[#18181b] bg-white p-6 sm:p-10 space-y-6">
            <div class="border-b border-[#e4e4e7] pb-4">
              <span class="font-mono text-xs text-[#71717a] uppercase block mb-1">Práctica Integral de Asignatura</span>
              <h2 class="text-2xl font-bold uppercase tracking-tight text-[#09090b]">
                Irrgarten · Videojuego de Exploración y Combate en Laberinto
              </h2>
              <p class="text-sm text-[#52525b] mt-2 leading-relaxed">
                Desarrollado como proyecto troncal de Programación y Diseño Orientado a Objetos (PDOO) en la ETSIIT UGR, implementado en Java y Ruby.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
              <div class="border border-[#e4e4e7] p-5 bg-[#fafafa]">
                <h3 class="font-bold uppercase font-mono text-xs text-[#09090b] mb-3 border-b border-[#e4e4e7] pb-2">
                  Arquitectura y Principios OO
                </h3>
                <ul class="space-y-2 text-xs text-[#3f3f46]">
                  <li><strong>• Herencia y Polimorfismo:</strong> Jerarquía base con clase abstracta <code class="font-mono bg-white px-1 border border-[#e4e4e7]">LabyrinthCharacter</code>, especializaciones <code class="font-mono bg-white px-1 border border-[#e4e4e7]">Player</code>, <code class="font-mono bg-white px-1 border border-[#e4e4e7]">Monster</code> y jugador avanzado <code class="font-mono bg-white px-1 border border-[#e4e4e7]">FuzzyPlayer</code>.</li>
                  <li><strong>• Desacoplamiento MVC:</strong> Modelo lógico del juego (<code class="font-mono bg-white px-1 border border-[#e4e4e7]">Game</code>, <code class="font-mono bg-white px-1 border border-[#e4e4e7]">Labyrinth</code>), controlador (<code class="font-mono bg-white px-1 border border-[#e4e4e7]">Controller</code>) y capas de vista desacopladas mediante interfaz común.</li>
                  <li><strong>• Vistas intercambiables:</strong> Soporte para interfaz modo texto por consola (<code class="font-mono bg-white px-1 border border-[#e4e4e7]">TextUI</code>) e interfaz gráfica mediante Java Swing (<code class="font-mono bg-white px-1 border border-[#e4e4e7]">GraphicUI</code>).</li>
                </ul>
              </div>

              <div class="border border-[#e4e4e7] p-5 bg-[#fafafa]">
                <h3 class="font-bold uppercase font-mono text-xs text-[#09090b] mb-3 border-b border-[#e4e4e7] pb-2">
                  Mecánicas de Juego & Dominio
                </h3>
                <ul class="space-y-2 text-xs text-[#3f3f46]">
                  <li><strong>• Sistema de Combate:</strong> Ataque y defensa calculados mediante fuerza/inteligencia más la energía aportada por armas (<code class="font-mono bg-white px-1 border border-[#e4e4e7]">Weapon</code>) y escudos (<code class="font-mono bg-white px-1 border border-[#e4e4e7]">Shield</code>).</li>
                  <li><strong>• Desgaste y Mazos de Cartas:</strong> Armas y escudos con número limitado de usos gestionados por barajas (<code class="font-mono bg-white px-1 border border-[#e4e4e7]">CardDeck</code>).</li>
                  <li><strong>• Movimiento y Azar:</strong> Comprobación de movimientos válidos, tiradas de dados (<code class="font-mono bg-white px-1 border border-[#e4e4e7]">Dice</code>) y condición de victoria al alcanzar la casilla de salida del laberinto.</li>
                </ul>
              </div>
            </div>

            <div class="pt-4 border-t border-[#e4e4e7] flex items-center justify-between font-mono text-xs">
              <span class="text-[#71717a]">Repositorio: MatthewHN/PDOO</span>
              <a
                href="https://github.com/MatthewHN/PDOO"
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 bg-[#18181b] text-white font-bold hover:bg-black transition-colors flex items-center gap-1.5"
              >
                <span>Explorar código fuente completo en GitHub</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        ) : (
          <div
            class="border border-[#18181b] bg-white p-6 sm:p-10 document-body markdown-math"
            set:html={doc.html}
          />
        )}
      </div>
    ))}

    <!-- Banner inferior de navegación -->
    <div class="mt-12 border-t border-[#18181b] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
      <span class="text-[#52525b]">
        Programación y Diseño Orientado a Objetos (PDOO) · GIIADE · Universidad de Granada
      </span>
      <a href="/universidad" class="font-bold text-[#09090b] hover:underline">
        Ver catálogo completo de asignaturas →
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Renderizado de fórmulas KaTeX
    if (window.renderMathInElement) {
      document.querySelectorAll('.markdown-math').forEach((el) => {
        window.renderMathInElement(el, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '$', right: '$', display: false },
            { left: '\\(', right: '\\)', display: false },
            { left: '\\[', right: '\\]', display: true }
          ],
          throwOnError: false
        });
      });
    }

    // 2. Sistema de pestañas para cambiar de documento
    const tabs = document.querySelectorAll('.doc-tab');
    const panes = document.querySelectorAll('.doc-pane');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-doc-id');

        // Actualizar botones
        tabs.forEach((t) => {
          t.classList.remove('bg-[#18181b]', 'text-white', 'border-[#18181b]');
          t.classList.add('bg-white', 'text-[#52525b]', 'border-[#d4d4d8]');
        });
        tab.classList.remove('bg-white', 'text-[#52525b]', 'border-[#d4d4d8]');
        tab.classList.add('bg-[#18181b]', 'text-white', 'border-[#18181b]');

        // Mostrar panel activo
        panes.forEach((pane) => {
          if (pane.id === `doc-content-${targetId}`) {
            pane.classList.remove('hidden');
            pane.classList.add('block');
          } else {
            pane.classList.add('hidden');
            pane.classList.remove('block');
          }
        });
      });
    });
  });
</script>

<style is:global>
  /* Tipografía y maquetación editorial para apuntes de PDOO */
  .document-body {
    color: #18181b;
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .document-body h1 {
    font-size: 1.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.025em;
    border-bottom: 2px solid #18181b;
    padding-bottom: 0.5rem;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
  }

  .document-body h2 {
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    border-bottom: 1px solid #e4e4e7;
    padding-bottom: 0.35rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #09090b;
  }

  .document-body h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: #27272a;
  }

  .document-body p {
    margin-bottom: 1.15rem;
  }

  .document-body ul, .document-body ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .document-body ul {
    list-style-type: disc;
  }

  .document-body ol {
    list-style-type: decimal;
  }

  .document-body li {
    margin-bottom: 0.35rem;
  }

  .document-body blockquote {
    border-left: 3px solid #18181b;
    padding-left: 1rem;
    margin: 1.25rem 0;
    font-style: italic;
    color: #3f3f46;
    background: #fafafa;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .document-body pre {
    background-color: #09090b !important;
    color: #f4f4f5 !important;
    padding: 1rem;
    border: 1px solid #18181b;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .document-body code:not(pre code) {
    background-color: #f4f4f5;
    color: #09090b;
    padding: 0.15rem 0.35rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.85em;
    border: 1px solid #e4e4e7;
  }

  .document-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-family: var(--font-mono, monospace);
    font-size: 0.825rem;
  }

  .document-body th, .document-body td {
    border: 1px solid #18181b;
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .document-body th {
    background-color: #f4f4f5;
    font-weight: 700;
  }

  .document-body hr {
    border: 0;
    border-top: 1px dashed #d4d4d8;
    margin: 2rem 0;
  }
</style>
