---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const doc = {
  id: "lavinquepizza-pdf",
  titulo: "Plan Comercial & Marketing: LaVinQuePizza",
  tipo: "DIAPOSITIVAS PDF",
  badgeColor: "bg-purple-100 text-purple-900 border-purple-300",
  downloadUrl: "/subjects/IM/lavinquepizza_presentacion.pdf",
  downloadLabel: "Descargar Presentación (PDF 862 KB)",
  resumen: "Estudio comercial y plan de marketing de LaVinQuePizza en Granada: decisiones de producto (pizza gigante 60x40 cm), fijación de precios, canales de distribución (reparto propio y plataformas) y estrategia de comunicación publicitaria."
};
---

<Layout
  title="IM · Introducción al Márketing | Javier Checa"
  description="Introducción al Márketing (2º UGR): Estudio comercial de LaVinQuePizza en Granada, decisiones de producto, precio, distribución y comunicación."
>
  <Header activeTab="universidad" />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <!-- Migas de pan -->
    <div class="border-b border-[#18181b] pb-4 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs">
      <div class="flex items-center gap-2 text-[#52525b]">
        <a href="/universidad" class="hover:text-black font-bold">[UNIVERSIDAD]</a>
        <span>/</span>
        <span>2º CURSO · UGR</span>
        <span>/</span>
        <span class="text-[#09090b] font-bold">IM · INTRODUCCIÓN AL MÁRKETING</span>
      </div>

      <a
        href="/universidad#stage-2-curso"
        class="px-3 py-1.5 bg-[#18181b] text-white hover:bg-black transition-colors font-bold w-fit"
      >
        ← Volver a Asignaturas
      </a>
    </div>

    <!-- Título de la Asignatura -->
    <div class="mb-8">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-[#52525b] mb-1">
        <span>[ RECURSOS ACADÉMICOS · UGR ]</span>
        <span>•</span>
        <span class="text-amber-700 font-bold">MARKETING & COMERCIAL</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#09090b] tracking-tight mb-2">
        Introducción al Márketing
      </h1>
      <p class="text-sm sm:text-base text-[#52525b] max-w-3xl">
        Conceptos clave de dirección comercial: investigación de mercados, segmentación y posicionamiento, y gestión del marketing mix tradicional (Producto, Precio, Distribución y Comunicación).
      </p>
    </div>

    <!-- Ficha técnica del documento -->
    <div class="border border-[#18181b] bg-white p-5 sm:p-6 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs shadow-sm">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span class={`px-2 py-0.5 border font-bold text-[11px] rounded ${doc.badgeColor}`}>
            {doc.tipo}
          </span>
          <h2 class="font-bold text-[#09090b] text-sm sm:text-base">
            {doc.titulo}
          </h2>
        </div>
        <p class="text-[#52525b] font-sans text-xs max-w-2xl leading-relaxed">
          {doc.resumen}
        </p>
      </div>

      <a
        href={doc.downloadUrl}
        download
        class="px-4 py-2 border border-[#18181b] bg-[#18181b] text-white hover:bg-[#27272a] transition-colors font-bold whitespace-nowrap flex items-center gap-2 self-start sm:self-auto text-xs shadow-sm"
      >
        <span>{doc.downloadLabel}</span>
        <span aria-hidden="true">↓</span>
      </a>
    </div>

    <!-- Visor PDF Embebido -->
    <div class="bg-white border border-[#18181b] p-4 sm:p-6 shadow-sm">
      <div class="w-full h-[800px] border border-zinc-300 rounded bg-zinc-100 overflow-hidden shadow-inner">
        <iframe
          src={doc.downloadUrl}
          class="w-full h-full border-0"
          title={doc.titulo}
        />
      </div>
    </div>

    <!-- Banner inferior de navegación -->
    <div class="mt-8 pt-4 border-t border-[#18181b] flex items-center justify-between font-mono text-xs text-[#52525b]">
      <span>Presentación comercial LaVinQuePizza · Grado Informática + ADE (UGR).</span>
      <a href="/universidad" class="hover:text-black font-bold">
        ← Volver al Plan de Estudios
      </a>
    </div>
  </main>

  <Footer />
</Layout>
