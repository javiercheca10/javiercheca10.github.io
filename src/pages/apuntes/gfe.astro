---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';

marked.setOptions({
  gfm: true,
  breaks: true,
});

const docs = [
  {
    id: "tema1-teoria",
    titulo: "Tema 1: Sistema Tributario y Elementos del Tributo",
    tipo: "TEORÍA & MARCO LEGAL",
    isPdf: false,
    badgeColor: "bg-emerald-100 text-emerald-900 border-emerald-300",
    path: "public/subjects/GFE/tema1_sistema_tributario_elementos.md",
    downloadUrl: "/subjects/GFE/tema1_sistema_tributario_elementos.md",
    downloadLabel: "Descargar Markdown",
    resumen: "Principios constitucionales tributarios (Art. 31 CE), Ley General Tributaria (LGT), clasificación de los tributos (tasas, contribuciones especiales, impuestos directos e indirectos) y cuantificación de la obligación tributaria (Base Imponible, Cuota Íntegra, Cuota Líquida, Cuota Diferencial y Deuda)."
  },
  {
    id: "is-teoria",
    titulo: "Tema 2: Impuesto sobre Sociedades (IS) - Marco Teórico",
    tipo: "TEORÍA & AMORTIZACIONES",
    isPdf: false,
    badgeColor: "bg-blue-100 text-blue-900 border-blue-300",
    path: "public/subjects/GFE/tema2_impuesto_sociedades_teoria_liquidacion.md",
    downloadUrl: "/subjects/GFE/tema2_impuesto_sociedades_teoria_liquidacion.md",
    downloadLabel: "Descargar Markdown",
    resumen: "Ley 27/2014 del Impuesto sobre Sociedades: métodos y límites de amortización fiscal, libertad de amortización, fondo de comercio (límite 1/20), determinación de la Base Imponible a partir del resultado contable con ajustes extracontables, tipos de gravamen, reserva de capitalización y esquema de liquidación."
  },
  {
    id: "is-practica",
    titulo: "Casos Prácticos de Examen: Liquidación Modelos A y B (IS)",
    tipo: "EXÁMENES RESUELTOS & ASIENTOS",
    isPdf: false,
    badgeColor: "bg-amber-100 text-amber-900 border-amber-300",
    path: "public/subjects/GFE/tema2_casos_practicos_examen_octubre2023.md",
    downloadUrl: "/subjects/GFE/tema2_casos_practicos_examen_octubre2023.md",
    downloadLabel: "Descargar Markdown",
    resumen: "Resolución íntegra de exámenes parciales (Octubre 2023): Modelo A (Gran Empresa / No ERD) y Modelo B (Pymes / Sí ERD). Ajustes por amortizaciones, provisiones no deducibles, criterio de caja en operaciones a plazos, atenciones a clientes (límite 1% INCN), liquidación y asientos contables del PGC."
  },
  {
    id: "ejercicios-iva",
    titulo: "Casos Prácticos de Examen: IVA (Prorratas, M303 y PGC)",
    tipo: "EXÁMENES RESUELTOS IVA",
    isPdf: false,
    badgeColor: "bg-teal-100 text-teal-900 border-teal-300",
    path: "public/subjects/GFE/ejercicios_iva_prorrata_regularizacion_m303.md",
    downloadUrl: "/subjects/GFE/ejercicios_iva_prorrata_regularizacion_m303.md",
    downloadLabel: "Descargar Markdown",
    resumen: "Exámenes oficiales resueltos de IVA (Enero 2025 Modelos A y B, Recuperación 2023, Parcial 2 Modelo D y 2023/24 Cuatrimestre B): cálculo de prorrata definitiva, regla del 10% de obligatoriedad (art. 103 LIVA), regularización de bienes de inversión, liquidaciones del Modelo 303 (4T) y asientos contables del PGC."
  },
  {
    id: "ejercicios-irpf",
    titulo: "Casos Prácticos de Examen: IRPF (EDN vs EDS y Ahorro)",
    tipo: "EXÁMENES RESUELTOS IRPF",
    isPdf: false,
    badgeColor: "bg-cyan-100 text-cyan-900 border-cyan-300",
    path: "public/subjects/GFE/ejercicios_irpf_actividades_economicas_ahorro.md",
    downloadUrl: "/subjects/GFE/ejercicios_irpf_actividades_economicas_ahorro.md",
    downloadLabel: "Descargar Markdown",
    resumen: "Ejercicios de examen de IRPF (2023/24 y Recuperación 2024): comparativa entre Estimación Directa Normal (EDN) y Estimación Directa Simplificada (EDS), amortizaciones de inmovilizado, reclasificación de Rendimientos del Capital Mobiliario, gastos de difícil justificación (tope 2.000 €) e integración en la Base Imponible del Ahorro."
  },
  {
    id: "practica6-irpf",
    titulo: "Práctica 6: Supuesto IRPF 2024 (Armando Casas)",
    tipo: "CASO PRÁCTICO & SIMULADOR AEAT",
    isPdf: false,
    badgeColor: "bg-rose-100 text-rose-900 border-rose-300",
    path: "public/subjects/GFE/practica6_calculo_irpf_armando_casas.md",
    downloadUrl: "/subjects/GFE/practica6_calculo_irpf_armando_casas.md",
    downloadLabel: "Descargar Markdown",
    resumen: "Resolución del caso práctico de D. Armando Casas (Arquitecto, EDS): ingresos de 267.000 €, dotación máxima de amortizaciones (9.840 €), tratamiento de morosos (art. 30.2.4ª RIRPF), gastos de difícil justificación (tope 2.000 €), ganancia patrimonial de solar en B.I. Ahorro (55.000 €), y conciliación con el Modelo 100 de la AEAT."
  },
  {
    id: "modelo100-pdf",
    titulo: "Borrador Oficial Modelo 100 IRPF 2024 (PDF AEAT)",
    tipo: "MODELO OFICIAL AEAT",
    isPdf: true,
    badgeColor: "bg-indigo-100 text-indigo-900 border-indigo-300",
    downloadUrl: "/subjects/GFE/practica6_irpf_modelo100_borrador.pdf",
    downloadLabel: "Descargar Modelo 100 (172 KB)",
    resumen: "Documento oficial generado en el simulador Renta WEB de la Agencia Tributaria (AEAT) con el Modelo 100 cumplimentado: casillas 0167 a 0700 con el desglose exacto de la autoliquidación a ingresar de 20.941,65 €."
  },
  {
    id: "cuaderno-completo-pdf",
    titulo: "Cuaderno Completo de la Asignatura (PDF 63 Págs)",
    tipo: "CUADERNO DIGITAL ESCANEADO",
    isPdf: true,
    badgeColor: "bg-purple-100 text-purple-900 border-purple-300",
    downloadUrl: "/subjects/GFE/cuaderno_completo_gestion_fiscal.pdf",
    downloadLabel: "Descargar PDF (9.5 MB)",
    resumen: "Cuaderno digital completo de 63 páginas de Gestión Fiscal de la Empresa (SICUE Valencia): Sistema Tributario, Impuesto sobre Sociedades (IS), Impuesto sobre el Valor Añadido (IVA con prorratas y regularizaciones) e IRPF (Estimación Directa Normal y Simplificada)."
  }
];

const renderedDocs = docs.map(doc => {
  if (doc.isPdf) {
    return {
      ...doc,
      html: ""
    };
  }
  const fullPath = path.join(process.cwd(), doc.path);
  let raw = "";
  if (fs.existsSync(fullPath)) {
    raw = fs.readFileSync(fullPath, 'utf-8');
  } else {
    raw = `*Generando documento: ${doc.titulo}... Por favor refresca la página en unos segundos.*`;
  }
  return {
    ...doc,
    html: marked.parse(raw)
  };
});
---

<Layout
  title="GFE · Gestión Fiscal de la Empresa | Javier Checa"
  description="Cuaderno técnico de Gestión Fiscal de la Empresa (SICUE Valencia): Sistema Tributario, Impuesto sobre Sociedades (IS), IVA e IRPF con supuestos prácticos de examen, práctica oficial del Modelo 100 en simulador AEAT y cuaderno completo."
>
  <Header activeTab="universidad" />

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
  <script is:inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"></script>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10">
    <!-- Migas de pan y cabecera técnica -->
    <div class="border-b border-[#18181b] pb-4 mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs">
      <div class="flex items-center gap-2 text-[#52525b]">
        <a href="/universidad" class="hover:text-black font-bold">[UNIVERSIDAD]</a>
        <span>/</span>
        <span>SICUE · VALENCIA</span>
        <span>/</span>
        <span class="text-[#09090b] font-bold">GFE · GESTIÓN FISCAL DE LA EMPRESA</span>
      </div>

      <a
        href="/universidad#stage-sicue-valencia"
        class="px-3 py-1.5 bg-[#18181b] text-white hover:bg-black transition-colors font-bold w-fit"
      >
        ← Volver a Asignaturas
      </a>
    </div>

    <!-- Título de la Asignatura -->
    <div class="mb-8">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-[#52525b] mb-1">
        <span>[ ARCHIVO DIGITALIZADO & LIQUIDACIONES TRIBUTARIAS ]</span>
        <span>//</span>
        <span>PROGRAMA DE MOVILIDAD SICUE</span>
      </div>
      <h1 class="text-3xl font-extrabold uppercase tracking-tight text-[#09090b]">
        Gestión Fiscal de la Empresa (GFE)
      </h1>
      <p class="text-xs sm:text-sm text-[#52525b] mt-2 max-w-3xl leading-relaxed">
        Cuaderno de estudio y liquidación tributaria empresarial conforme a la Ley General Tributaria (LGT), la Ley del Impuesto sobre Sociedades (Ley 27/2014 LIS), la Ley del IVA y el IRPF: principios constitucionales, ajustes extracontables, amortizaciones deducibles, ejercicios de exámenes oficiales resueltos (IVA e IRPF), práctica oficial del Modelo 100 de IRPF y cuaderno íntegro de 63 páginas.
      </p>
    </div>

    <!-- Selector de Documentos (Pestañas) -->
    <div class="border border-[#18181b] bg-[#f4f4f5] p-2 mb-8 flex flex-wrap gap-1.5 font-mono text-xs" id="doc-tabs">
      {renderedDocs.map((doc, idx) => (
        <button
          data-doc-id={doc.id}
          class={`doc-tab px-3 py-2 text-left font-bold border transition-colors flex items-center justify-between gap-3 ${idx === 0 ? 'bg-[#18181b] text-white border-[#18181b]' : 'bg-white text-[#52525b] hover:text-black border-[#d4d4d8] hover:border-[#18181b]'}`}
        >
          <span>📁 {doc.titulo}</span>
          <span class={`text-[10px] px-1.5 py-0.2 border ${doc.badgeColor}`}>
            {doc.tipo}
          </span>
        </button>
      ))}
    </div>

    <!-- Contenedores de Documentos -->
    {renderedDocs.map((doc, idx) => (
      <div
        id={`doc-content-${doc.id}`}
        class={`doc-pane ${idx === 0 ? 'block' : 'hidden'}`}
      >
        <!-- Ficha técnica del documento activo -->
        <div class="border border-[#18181b] bg-[#f4f4f5] p-5 mb-6 font-mono text-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="font-bold text-[#09090b] uppercase">{doc.titulo}</span>
              <span class={`px-2 py-0.5 border text-[10px] font-bold ${doc.badgeColor}`}>
                {doc.tipo}
              </span>
            </div>
            <p class="text-[#52525b] max-w-2xl leading-relaxed">{doc.resumen}</p>
          </div>

          <div class="flex items-center gap-2">
            <a
              href={doc.downloadUrl}
              download
              class="px-3 py-1.5 bg-white border border-[#18181b] hover:bg-[#18181b] hover:text-white transition-colors font-bold flex items-center gap-1.5"
            >
              <span>📥 {doc.downloadLabel}</span>
            </a>
            {doc.isPdf && (
              <a
                href={doc.downloadUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-3 py-1.5 bg-[#18181b] text-white hover:bg-black transition-colors font-bold flex items-center gap-1.5"
              >
                <span>↗ Abrir en pestaña</span>
              </a>
            )}
          </div>
        </div>

        {doc.isPdf ? (
          <div class="border border-[#18181b] bg-white p-4">
            <div class="mb-4 pb-3 border-b border-[#e4e4e7] flex items-center justify-between font-mono text-xs text-[#52525b]">
              <span>VISOR INTEGRADO · {doc.titulo.toUpperCase()}</span>
              <span>FORMATO: PDF / DOCUMENTO ADJUNTO</span>
            </div>
            <div class="w-full bg-[#f4f4f5] border border-[#e4e4e7] overflow-hidden" style="height: 820px;">
              <iframe
                src={`${doc.downloadUrl}#view=FitH`}
                class="w-full h-full border-0"
                title={doc.titulo}
              >
                <div class="p-8 text-center font-mono text-xs">
                  <p class="mb-4">Tu navegador no soporta la visualización directa de PDFs.</p>
                  <a
                    href={doc.downloadUrl}
                    class="px-4 py-2 bg-[#18181b] text-white font-bold"
                    download
                  >
                    Descargar Documento PDF
                  </a>
                </div>
              </iframe>
            </div>
          </div>
        ) : (
          <div
            class="border border-[#18181b] bg-white p-6 sm:p-10 document-body markdown-math"
            set:html={doc.html}
          />
        )}
      </div>
    ))}

    <!-- Banner inferior de navegación -->
    <div class="mt-12 border-t border-[#18181b] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
      <span class="text-[#52525b]">
        Gestión Fiscal de la Empresa (GFE) · Programa SICUE Valencia
      </span>
      <a href="/universidad" class="font-bold text-[#09090b] hover:underline">
        Ver catálogo completo de asignaturas →
      </a>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Renderizado de fórmulas KaTeX
    if (window.renderMathInElement) {
      document.querySelectorAll('.markdown-math').forEach((el) => {
        window.renderMathInElement(el, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '$', right: '$', display: false },
            { left: '\\(', right: '\\)', display: false },
            { left: '\\[', right: '\\]', display: true }
          ],
          throwOnError: false
        });
      });
    }

    // 2. Sistema de pestañas para cambiar de documento
    const tabs = document.querySelectorAll('.doc-tab');
    const panes = document.querySelectorAll('.doc-pane');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-doc-id');

        // Actualizar botones
        tabs.forEach((t) => {
          t.classList.remove('bg-[#18181b]', 'text-white', 'border-[#18181b]');
          t.classList.add('bg-white', 'text-[#52525b]', 'border-[#d4d4d8]');
        });
        tab.classList.remove('bg-white', 'text-[#52525b]', 'border-[#d4d4d8]');
        tab.classList.add('bg-[#18181b]', 'text-white', 'border-[#18181b]');

        // Mostrar panel activo
        panes.forEach((pane) => {
          if (pane.id === `doc-content-${targetId}`) {
            pane.classList.remove('hidden');
            pane.classList.add('block');
          } else {
            pane.classList.add('hidden');
            pane.classList.remove('block');
          }
        });
      });
    });
  });
</script>

<style is:global>
  /* Tipografía y maquetación editorial para apuntes fiscales y contables */
  .document-body {
    color: #18181b;
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  .document-body h1 {
    font-size: 1.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.025em;
    border-bottom: 2px solid #18181b;
    padding-bottom: 0.5rem;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
  }

  .document-body h2 {
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    border-bottom: 1px solid #e4e4e7;
    padding-bottom: 0.35rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #09090b;
  }

  .document-body h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: #27272a;
  }

  .document-body p {
    margin-bottom: 1.15rem;
  }

  .document-body ul, .document-body ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .document-body ul {
    list-style-type: disc;
  }

  .document-body ol {
    list-style-type: decimal;
  }

  .document-body li {
    margin-bottom: 0.35rem;
  }

  .document-body blockquote {
    border-left: 3px solid #18181b;
    padding-left: 1rem;
    margin: 1.25rem 0;
    font-style: italic;
    color: #3f3f46;
    background: #fafafa;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .document-body pre {
    background-color: #09090b !important;
    color: #f4f4f5 !important;
    padding: 1rem;
    border: 1px solid #18181b;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .document-body code:not(pre code) {
    background-color: #f4f4f5;
    color: #09090b;
    padding: 0.15rem 0.35rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.85em;
    border: 1px solid #e4e4e7;
  }

  .document-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-family: var(--font-mono, monospace);
    font-size: 0.825rem;
  }

  .document-body th, .document-body td {
    border: 1px solid #18181b;
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .document-body th {
    background-color: #f4f4f5;
    font-weight: 700;
  }

  .document-body hr {
    border: 0;
    border-top: 1px dashed #d4d4d8;
    margin: 2rem 0;
  }

  .document-body strong {
    font-weight: 700;
    color: #09090b;
  }
</style>
