---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import academic from '../data/academic.json';

const totalSubjects = academic.reduce((acc, c) => acc + c.groups.reduce((gAcc, g) => gAcc + g.subjects.length, 0), 0);
---

<Layout
  title="Grado Universitario · GIIADE | Javier Checa"
  description="Plan de estudios y recursos del Doble Grado en Ingeniería Informática y ADE: 1º a 3º UGR, Erasmus en Atenas, SICUE en Valencia y 6º curso."
>
  <Header activeTab="universidad" />

  <main class="max-w-5xl mx-auto px-6 pt-12 pb-16">
    <!-- Encabezado de la Subdivisión -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-[#8a8a93] mb-3">
        <span>01 / SUBDIVISIÓN ACADÉMICA</span>
        <span>•</span>
        <span>UGR · ETSIIT & FCEE</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-medium tracking-tight text-[#111113]">
        Grado <span class="font-serif-italic font-normal text-[1.12em]">Universitario</span>
      </h1>
      
      <p class="mt-3 text-sm sm:text-base text-[#6e6e76] max-w-2xl leading-relaxed">
        Itinerario académico del Doble Grado en Ingeniería Informática y ADE en 6 etapas: tres cursos troncales en la Universidad de Granada, estancia Erasmus en Atenas, movilidad SICUE en Valencia y 6º curso de finalización.
      </p>
    </div>

    <!-- Barra de Búsqueda y Filtros de Etapas estilo Daniel Sun -->
    <div class="border border-[#eaeaea] rounded-2xl p-4 mb-12 bg-[#fafafc] flex flex-col md:flex-row items-center justify-between gap-4">
      <!-- Buscador en tiempo real -->
      <div class="relative w-full md:w-80">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#9696a0]">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="academic-search"
          placeholder="Buscar asignatura o código (ej. CAL, FP, EDO)..."
          class="w-full pl-10 pr-4 py-2 text-xs sm:text-sm bg-white border border-[#eaeaea] rounded-xl text-[#111113] placeholder-[#9696a0] focus:outline-none focus:border-black transition-colors"
        />
      </div>

      <!-- Filtro de Etapas -->
      <div class="flex items-center gap-1.5 overflow-x-auto w-full md:w-auto pb-1 md:pb-0" id="stage-filter-buttons">
        <button
          data-filter="all"
          class="stage-filter active px-3 py-1.5 rounded-xl text-xs font-medium bg-black text-white transition-all whitespace-nowrap"
        >
          Todas ({totalSubjects})
        </button>
        {academic.map(stage => (
          <button
            data-filter={stage.id}
            class="stage-filter px-3 py-1.5 rounded-xl text-xs font-medium bg-white text-[#6e6e76] hover:text-black border border-[#eaeaea] hover:border-black transition-all whitespace-nowrap"
          >
            {stage.name}
          </button>
        ))}
      </div>
    </div>

    <!-- Lista de Etapas Académicas -->
    <div class="space-y-16" id="stages-container">
      {academic.map(stage => (
        <section class="stage-section" data-stage={stage.id}>
          <!-- Cabecera de la etapa -->
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between pb-4 border-b border-[#eaeaea] gap-2 mb-8">
            <div class="flex items-baseline gap-3">
              <span class="text-xs font-mono text-[#8a8a93]">{stage.num}</span>
              <h2 class="text-xl sm:text-2xl font-semibold text-[#111113] tracking-tight">
                {stage.name}
              </h2>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-[#f0f0f2] text-[#4a4a52]">
                {stage.tag}
              </span>
            </div>
            <p class="text-xs text-[#8a8a93] font-mono">
              {stage.location}
            </p>
          </div>

          <p class="text-xs sm:text-sm text-[#6e6e76] mb-8 -mt-4">
            {stage.description}
          </p>

          <!-- Semestres -->
          <div class="space-y-10">
            {stage.groups.map(group => (
              <div>
                <h3 class="text-xs font-mono uppercase tracking-wider text-[#8a8a93] mb-4 flex items-center gap-2">
                  <span>/</span> {group.name}
                </h3>

                <!-- Rejilla de Asignaturas -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  {group.subjects.map(subject => (
                    <article
                      class="subject-item p-5 rounded-2xl border border-[#eaeaea] hover:border-black bg-white transition-all duration-150 flex flex-col justify-between"
                      data-code={subject.code.toLowerCase()}
                      data-name={subject.name.toLowerCase()}
                      data-stage={stage.id}
                    >
                      <div>
                        <div class="flex items-center justify-between mb-2">
                          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded bg-[#f5f5f7] text-[#111113]">
                            {subject.code}
                          </span>
                          <span class="text-[11px] font-mono text-[#8a8a93]">
                            {stage.tag}
                          </span>
                        </div>

                        <h4 class="text-sm font-semibold text-[#111113] leading-snug">
                          {subject.name}
                        </h4>

                        {subject.description && (
                          <p class="text-xs text-[#6e6e76] mt-2 leading-relaxed">
                            {subject.description}
                          </p>
                        )}
                      </div>

                      <div class="mt-4 pt-3 border-t border-[#f2f2f4] flex items-center justify-between text-xs font-mono text-[#8a8a93]">
                        {subject.guia ? (
                          <a
                            href={subject.guia}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-[#111113] hover:underline flex items-center gap-1 font-sans text-xs font-medium"
                          >
                            <span>Guía UGR</span>
                            <span aria-hidden="true">↗</span>
                          </a>
                        ) : (
                          <span class="text-[#a0a0a8] text-[11px]">Guía oficial</span>
                        )}

                        <span class="text-[11px]">Recursos</span>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <div id="no-academic-results" class="hidden text-center py-16">
      <p class="text-sm font-semibold text-[#111113]">
        No se encontraron asignaturas con ese criterio.
      </p>
      <p class="text-xs text-[#8a8a93] mt-1">
        Prueba a buscar por código abreviado (ej: CAL, FP, EDO) o nombre.
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const searchInput = document.getElementById('academic-search');
  const stageFilters = document.querySelectorAll('.stage-filter');
  const stageSections = document.querySelectorAll('.stage-section');
  const subjectItems = document.querySelectorAll('.subject-item');
  const noResults = document.getElementById('no-academic-results');

  let currentStage = 'all';

  function filterAcademic() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    let totalVisible = 0;

    stageSections.forEach(section => {
      const stageId = section.dataset.stage;
      const isStageMatch = currentStage === 'all' || currentStage === stageId;

      if (!isStageMatch) {
        section.style.display = 'none';
        return;
      }

      let sectionVisibleCount = 0;
      const cards = section.querySelectorAll('.subject-item');

      cards.forEach(card => {
        const code = card.dataset.code || '';
        const name = card.dataset.name || '';
        const matchesQuery = !query || code.includes(query) || name.includes(query);

        if (matchesQuery) {
          card.style.display = 'flex';
          sectionVisibleCount++;
          totalVisible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (sectionVisibleCount > 0) {
        section.style.display = 'block';
      } else {
        section.style.display = 'none';
      }
    });

    if (noResults) {
      if (totalVisible === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterAcademic);
  }

  stageFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      stageFilters.forEach(b => {
        b.classList.remove('bg-black', 'text-white');
        b.classList.add('bg-white', 'text-[#6e6e76]', 'border-[#eaeaea]');
      });
      btn.classList.add('bg-black', 'text-white');
      btn.classList.remove('bg-white', 'text-[#6e6e76]');

      currentStage = btn.dataset.filter || 'all';
      filterAcademic();
    });
  });
</script>
