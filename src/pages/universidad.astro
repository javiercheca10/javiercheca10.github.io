---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import academic from '../data/academic.json';

const totalSubjects = academic.reduce((acc, c) => acc + c.groups.reduce((gAcc, g) => gAcc + g.subjects.length, 0), 0);
---

<Layout
  title="Universidad · Catálogo GIIADE UGR | Javier Checa"
  description="Plan de estudios oficial de las 6 etapas del Doble Grado en Informática y ADE: 1º a 3º UGR, Erasmus Atenas, SICUE Valencia y 6º Curso."
>
  <Header activeTab="universidad" />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <!-- Encabezado técnico -->
    <div class="border-b border-[#18181b] pb-8 mb-8">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-[#52525b] mb-2">
        <span>[ ARCHIVO ACADÉMICO ]</span>
        <span>//</span>
        <span>UGR · ETSIIT & FCEE</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-[#09090b]">
        Plan Curricular GIIADE · {totalSubjects} Asignaturas
      </h1>
      <p class="mt-3 text-sm text-[#52525b] max-w-3xl leading-relaxed">
        Catálogo completo de asignaturas cursadas a lo largo de seis etapas académicas: cursos troncales en la Universidad de Granada, intercambio internacional Erasmus en Atenas, movilidad SICUE en Valencia y 6º curso de finalización.
      </p>

      <!-- Barra de control industrial: Buscador y Filtro -->
      <div class="mt-8 pt-6 border-t border-[#e4e4e7] flex flex-col md:flex-row items-center justify-between gap-4 font-mono text-xs">
        <div class="relative w-full md:w-96">
          <input
            type="text"
            id="search-input"
            placeholder="[FILTRAR] Código o nombre (ej. CAL, FP, EDO)..."
            class="w-full px-3 py-2 bg-white border border-[#18181b] text-[#09090b] placeholder-[#71717a] focus:outline-none focus:ring-1 focus:ring-black"
          />
        </div>

        <div class="flex items-center gap-1.5 overflow-x-auto w-full md:w-auto pb-1 md:pb-0" id="filter-buttons">
          <button
            data-filter="all"
            class="filter-tag active px-3 py-1.5 bg-[#18181b] text-white font-bold border border-[#18181b] whitespace-nowrap"
          >
            TODAS ({totalSubjects})
          </button>
          {academic.map(stage => (
            <button
              data-filter={stage.id}
              class="filter-tag px-3 py-1.5 bg-white text-[#52525b] hover:text-[#09090b] border border-[#d4d4d8] hover:border-[#18181b] font-medium whitespace-nowrap"
            >
              {stage.name}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Etapas Académicas -->
    <div class="space-y-12" id="academic-list">
      {academic.map(stage => (
        <section class="stage-block border border-[#18181b] bg-white" data-stage={stage.id} id={`stage-${stage.id}`}>
          <!-- Cabecera de la etapa -->
          <div class="bg-[#f4f4f5] border-b border-[#18181b] p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold px-2 py-0.5 bg-[#18181b] text-white">
                ETAPA {stage.num}
              </span>
              <h2 class="text-xl font-bold uppercase tracking-tight text-[#09090b]">
                {stage.name}
              </h2>
              <span class="font-mono text-xs text-[#52525b] hidden sm:inline">
                [{stage.tag}]
              </span>
            </div>
            <div class="font-mono text-xs text-[#71717a]">
              {stage.location}
            </div>
          </div>

          <div class="p-4 sm:p-5 border-b border-[#e4e4e7] text-xs sm:text-sm text-[#52525b] bg-[#fafafa]">
            {stage.description}
          </div>

          <!-- Grupos / Semestres -->
          <div class="p-4 sm:p-6 space-y-8">
            {stage.groups.map(group => (
              <div>
                <div class="flex items-center gap-2 font-mono text-xs font-bold uppercase text-[#52525b] pb-2 border-b border-[#e4e4e7] mb-4">
                  <span>//</span>
                  <span>{group.name}</span>
                </div>

                <!-- Tabla de Asignaturas -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {group.subjects.map(subject => (
                    <div
                      class="subject-entry p-3.5 border border-[#e4e4e7] hover:border-[#18181b] bg-white transition-colors flex flex-col justify-between"
                      data-code={subject.code.toLowerCase()}
                      data-name={subject.name.toLowerCase()}
                      data-stage={stage.id}
                    >
                      <div>
                        <div class="flex items-center justify-between font-mono text-xs mb-1.5">
                          <span class="font-bold text-[#09090b] px-1.5 py-0.2 bg-[#f4f4f5] border border-[#d4d4d8]">
                            {subject.code}
                          </span>
                          <span class="text-[11px] text-[#71717a]">
                            {stage.num} · {stage.tag}
                          </span>
                        </div>

                        <h3 class="text-sm font-bold text-[#09090b] leading-snug">
                          {subject.name}
                        </h3>

                        {subject.description && (
                          <p class="text-xs text-[#52525b] mt-1.5 leading-relaxed">
                            {subject.description}
                          </p>
                        )}
                      </div>

                      <div class="mt-3 pt-2.5 border-t border-[#f4f4f5] flex items-center justify-between text-xs font-mono">
                        {subject.guia ? (
                          <a
                            href={subject.guia}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-bold text-[#09090b] hover:underline flex items-center gap-1"
                          >
                            <span>Guía Docente UGR</span>
                            <span aria-hidden="true">↗</span>
                          </a>
                        ) : (
                          <span class="text-[#a1a1aa] text-[11px]">Guía oficial</span>
                        )}

                        <span class="text-[11px] text-[#71717a]">
                          Recursos
                        </span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <!-- Mensaje si no hay resultados -->
    <div id="no-results" class="hidden text-center py-16 font-mono text-xs border border-dashed border-[#a1a1aa] p-8 mt-6">
      <p class="font-bold text-[#09090b]">SIN RESULTADOS PARA EL CRITERIO INDICADO</p>
      <p class="text-[#71717a] mt-1">Verifica el código (ej. CAL, FP, EDO) o parte del nombre.</p>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  const searchInput = document.getElementById('search-input');
  const filterTags = document.querySelectorAll('.filter-tag');
  const stageBlocks = document.querySelectorAll('.stage-block');
  const subjectEntries = document.querySelectorAll('.subject-entry');
  const noResults = document.getElementById('no-results');

  let currentStage = 'all';

  function filterList() {
    const query = (searchInput?.value || '').toLowerCase().trim();
    let totalVisible = 0;

    stageBlocks.forEach(stage => {
      const stageId = stage.dataset.stage;
      const isStageMatch = currentStage === 'all' || currentStage === stageId;

      if (!isStageMatch) {
        stage.style.display = 'none';
        return;
      }

      let stageCount = 0;
      const cards = stage.querySelectorAll('.subject-entry');

      cards.forEach(card => {
        const code = card.dataset.code || '';
        const name = card.dataset.name || '';
        const matchesQuery = !query || code.includes(query) || name.includes(query);

        if (matchesQuery) {
          card.style.display = 'flex';
          stageCount++;
          totalVisible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (stageCount > 0) {
        stage.style.display = 'block';
      } else {
        stage.style.display = 'none';
      }
    });

    if (noResults) {
      if (totalVisible === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterList);
  }

  filterTags.forEach(btn => {
    btn.addEventListener('click', () => {
      filterTags.forEach(b => {
        b.classList.remove('bg-[#18181b]', 'text-white', 'font-bold');
        b.classList.add('bg-white', 'text-[#52525b]');
      });
      btn.classList.add('bg-[#18181b]', 'text-white', 'font-bold');
      btn.classList.remove('bg-white', 'text-[#52525b]');

      currentStage = btn.dataset.filter || 'all';
      filterList();
    });
  });
</script>
