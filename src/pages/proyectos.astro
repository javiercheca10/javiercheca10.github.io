---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import projects from '../data/projects.json';
---

<Layout
  title="Proyectos Personales | Javier Checa"
  description="Proyectos de software, optimización con Google OR-Tools CP-SAT, aplicaciones Qt y herramientas de análisis desarrolladas por Javier Checa."
>
  <Header activeTab="proyectos" />

  <main class="max-w-5xl mx-auto px-6 pt-12 pb-16">
    <!-- Encabezado de la Subdivisión -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-mono text-[#8a8a93] mb-3">
        <span>02 / SUBDIVISIÓN DE SOFTWARE</span>
        <span>•</span>
        <span>Código & Arquitectura</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-medium tracking-tight text-[#111113]">
        Proyectos <span class="font-serif-italic font-normal text-[1.12em]">Personales</span>
      </h1>
      
      <p class="mt-3 text-sm sm:text-base text-[#6e6e76] max-w-2xl leading-relaxed">
        Desarrollo de software enfocado en la resolución de problemas reales, optimización combinatoria, aplicaciones de escritorio e interfaces interactivas.
      </p>
    </div>

    <!-- Lista de Proyectos estilo Editorial Daniel Sun -->
    <div class="space-y-8">
      {projects.map((project, index) => (
        <article class="p-8 rounded-2xl border border-[#eaeaea] hover:border-black bg-white transition-all duration-200">
          <div class="flex flex-col md:flex-row md:items-baseline justify-between gap-2 pb-4 border-b border-[#f0f0f2]">
            <div class="flex items-baseline gap-3">
              <span class="text-xs font-mono text-[#8a8a93]">0{index + 1}</span>
              <h2 class="text-xl sm:text-2xl font-semibold text-[#111113] tracking-tight">
                {project.title}
              </h2>
            </div>
            <span class="text-xs font-mono text-[#6e6e76]">
              {project.badge}
            </span>
          </div>

          <p class="text-sm font-medium text-[#111113] mt-4">
            {project.subtitle}
          </p>

          <p class="text-xs sm:text-sm text-[#6e6e76] mt-2 leading-relaxed max-w-3xl">
            {project.description}
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            {project.tags.map(tag => (
              <span class="px-2.5 py-1 rounded bg-[#f5f5f7] text-[#4a4a52] text-xs font-mono">
                {tag}
              </span>
            ))}
          </div>

          <div class="mt-6 pt-5 border-t border-[#f0f0f2] flex items-center justify-between">
            <div class="flex items-center gap-4 text-xs font-medium">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[#111113] hover:underline flex items-center gap-1.5"
                >
                  <span>Ver código en GitHub</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[#111113] hover:underline flex items-center gap-1.5"
                >
                  <span>Sitio en vivo</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>

            <span class="text-[11px] font-mono text-[#8a8a93]">
              #{project.id}
            </span>
          </div>
        </article>
      ))}
    </div>

    <!-- Espacio preparado para futuros proyectos -->
    <div class="mt-12 p-8 rounded-2xl border border-dashed border-[#d5d5db] text-center">
      <p class="text-xs sm:text-sm text-[#6e6e76]">
        Espacio configurado para añadir tus próximos proyectos personales. Puedes incorporar fichas editando simplemente el archivo <code class="px-1.5 py-0.5 rounded bg-[#f5f5f7] font-mono text-xs text-[#111113]">src/data/projects.json</code>.
      </p>
    </div>
  </main>

  <Footer />
</Layout>
