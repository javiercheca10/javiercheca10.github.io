---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import projects from '../data/projects.json';

const countAll = projects.length;
const countUniv = projects.filter(p => p.category === 'universidad').length;
const countPersonal = projects.filter(p => p.category === 'personal').length;
---

<Layout
  title="Proyectos · Software & Optimización | Javier Checa"
  description="Catálogo de proyectos personales y universitarios: optimización con Google OR-Tools CP-SAT, agentes inteligentes en C++ y aplicaciones en Java/Ruby."
>
  <Header activeTab="proyectos" />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <!-- Encabezado técnico -->
    <div class="border-b border-[#18181b] pb-8 mb-8">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-[#52525b] mb-2">
        <span>[ ARCHIVO DE SOFTWARE ]</span>
        <span>//</span>
        <span>CÓDIGO & ARQUITECTURA</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-[#09090b]">
        Proyectos & Herramientas
      </h1>
      <p class="mt-3 text-sm text-[#52525b] max-w-3xl leading-relaxed">
        Soluciones prácticas desarrolladas combinando ingeniería de sistemas, modelos matemáticos de optimización, agentes inteligentes y aplicaciones de software.
      </p>

      <!-- Selector de Proyectos (Filtro por Categorías) -->
      <div class="mt-8 pt-6 border-t border-[#e4e4e7] flex items-center gap-1.5 overflow-x-auto font-mono text-xs" id="project-filter-buttons">
        <button
          data-filter="all"
          class="project-filter-tag active px-3 py-1.5 bg-[#18181b] text-white font-bold border border-[#18181b] whitespace-nowrap transition-colors"
        >
          TODOS LOS PROYECTOS ({countAll})
        </button>
        <button
          data-filter="universidad"
          class="project-filter-tag px-3 py-1.5 bg-white text-[#52525b] hover:text-[#09090b] border border-[#d4d4d8] hover:border-[#18181b] font-medium whitespace-nowrap transition-colors"
        >
          UNIVERSIDAD ({countUniv})
        </button>
        <button
          data-filter="personal"
          class="project-filter-tag px-3 py-1.5 bg-white text-[#52525b] hover:text-[#09090b] border border-[#d4d4d8] hover:border-[#18181b] font-medium whitespace-nowrap transition-colors"
        >
          OTROS PROYECTOS ({countPersonal})
        </button>
      </div>
    </div>

    <!-- Lista técnica de proyectos -->
    <div class="space-y-6" id="projects-container">
      {projects.map((proj, idx) => (
        <article
          data-category={proj.category}
          class="project-item border border-[#18181b] bg-white transition-opacity"
        >
          <div class="p-5 sm:p-6 bg-[#f4f4f5] border-b border-[#18181b] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold px-2 py-0.5 bg-[#18181b] text-white">
                PROYECTO 0{idx + 1}
              </span>
              <h2 class="text-xl font-bold uppercase tracking-tight text-[#09090b]">
                {proj.title}
              </h2>
            </div>
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs px-2 py-0.5 bg-[#e4e4e7] border border-[#d4d4d8] text-[#52525b] font-bold w-fit">
                {proj.categoryLabel}
              </span>
              <span class="font-mono text-xs px-2 py-0.5 bg-white border border-[#18181b] text-[#09090b] font-bold w-fit">
                {proj.badge}
              </span>
            </div>
          </div>

          <div class="p-6 sm:p-8 space-y-4">
            <p class="text-sm font-semibold text-[#09090b]">
              {proj.subtitle}
            </p>

            <p class="text-xs sm:text-sm text-[#52525b] leading-relaxed max-w-4xl">
              {proj.description}
            </p>

            <div class="pt-4 border-t border-[#e4e4e7] flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
              <div class="flex flex-wrap gap-1.5">
                {proj.tags.map(t => (
                  <span class="px-2 py-0.5 bg-[#f4f4f5] border border-[#e4e4e7] text-[#3f3f46]">
                    {t}
                  </span>
                ))}
              </div>

              <div class="flex flex-wrap items-center gap-3">
                {proj.github && (
                  <a
                    href={proj.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3 py-1.5 bg-[#18181b] text-white font-bold hover:bg-black transition-colors flex items-center gap-1.5"
                  >
                    <span>{proj.githubExtra ? 'Ver Repositorio (P2 · A*)' : 'Ver Repositorio GitHub'}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
                {proj.githubExtra && (
                  <a
                    href={proj.githubExtra.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3 py-1.5 bg-white border border-[#18181b] text-[#09090b] font-bold hover:bg-[#f4f4f5] transition-colors flex items-center gap-1.5"
                  >
                    <span>{proj.githubExtra.label}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
                {proj.demo && (
                  <a
                    href={proj.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3 py-1.5 border border-[#18181b] text-[#09090b] font-bold hover:bg-[#f4f4f5] transition-colors flex items-center gap-1.5"
                  >
                    <span>Acceder a la Web</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.project-filter-tag');
    const projectCards = document.querySelectorAll('.project-item');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Actualizar estados visuales de los botones
        filterButtons.forEach((b) => {
          b.classList.remove('bg-[#18181b]', 'text-white', 'border-[#18181b]', 'font-bold', 'active');
          b.classList.add('bg-white', 'text-[#52525b]', 'border-[#d4d4d8]', 'font-medium');
        });
        btn.classList.remove('bg-white', 'text-[#52525b]', 'border-[#d4d4d8]', 'font-medium');
        btn.classList.add('bg-[#18181b]', 'text-white', 'border-[#18181b]', 'font-bold', 'active');

        // Filtrar tarjetas de proyectos
        projectCards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
