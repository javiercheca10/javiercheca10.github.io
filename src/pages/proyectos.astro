---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import projects from '../data/projects.json';
---

<Layout
  title="Proyectos · Software & Optimización | Javier Checa"
  description="Catálogo de proyectos personales de desarrollo de software, optimización con Google OR-Tools CP-SAT, aplicaciones de escritorio y herramientas."
>
  <Header activeTab="proyectos" />

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
    <!-- Encabezado técnico -->
    <div class="border-b border-[#18181b] pb-8 mb-8">
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-[#52525b] mb-2">
        <span>[ ARCHIVO DE SOFTWARE ]</span>
        <span>//</span>
        <span>CÓDIGO & ARQUITECTURA</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold uppercase tracking-tight text-[#09090b]">
        Proyectos Personales & Herramientas
      </h1>
      <p class="mt-3 text-sm text-[#52525b] max-w-3xl leading-relaxed">
        Soluciones prácticas desarrolladas combinando ingeniería de sistemas, modelos matemáticos de optimización y gestión empresarial. Cada proyecto incluye stack tecnológico y enlaces de acceso.
      </p>
    </div>

    <!-- Lista técnica de proyectos -->
    <div class="space-y-6">
      {projects.map((proj, idx) => (
        <article class="border border-[#18181b] bg-white">
          <div class="p-5 sm:p-6 bg-[#f4f4f5] border-b border-[#18181b] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold px-2 py-0.5 bg-[#18181b] text-white">
                PROYECTO 0{idx + 1}
              </span>
              <h2 class="text-xl font-bold uppercase tracking-tight text-[#09090b]">
                {proj.title}
              </h2>
            </div>
            <span class="font-mono text-xs px-2 py-0.5 bg-white border border-[#18181b] text-[#09090b] font-bold w-fit">
              {proj.badge}
            </span>
          </div>

          <div class="p-6 sm:p-8 space-y-4">
            <p class="text-sm font-semibold text-[#09090b]">
              {proj.subtitle}
            </p>

            <p class="text-xs sm:text-sm text-[#52525b] leading-relaxed max-w-4xl">
              {proj.description}
            </p>

            <div class="pt-4 border-t border-[#e4e4e7] flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
              <div class="flex flex-wrap gap-1.5">
                {proj.tags.map(t => (
                  <span class="px-2 py-0.5 bg-[#f4f4f5] border border-[#e4e4e7] text-[#3f3f46]">
                    {t}
                  </span>
                ))}
              </div>

              <div class="flex items-center gap-4">
                {proj.github && (
                  <a
                    href={proj.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3 py-1.5 bg-[#18181b] text-white font-bold hover:bg-black transition-colors flex items-center gap-1.5"
                  >
                    <span>Ver Repositorio GitHub</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
                {proj.demo && (
                  <a
                    href={proj.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3 py-1.5 border border-[#18181b] text-[#09090b] font-bold hover:bg-[#f4f4f5] transition-colors flex items-center gap-1.5"
                  >
                    <span>Acceder a la Web</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
