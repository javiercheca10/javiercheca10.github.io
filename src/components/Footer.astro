---
import profile from '../data/profile.json';
---

<footer class="w-full border-t border-[#18181b] bg-white mt-16 font-mono text-xs text-[#52525b]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <span class="font-bold text-[#09090b]">[GIIADE · UGR]</span>
      <span>Javier Checa</span>
      <span>//</span>
      <span>Granada · España</span>
    </div>

    <div class="flex items-center gap-6">
      <a href="/universidad" class="hover:text-black transition-colors">[01] Grado</a>
      <a href="/proyectos" class="hover:text-black transition-colors">[02] Proyectos</a>
      <a href="/sobre-mi" class="hover:text-black transition-colors">[03] Sobre mí</a>
      <a href={profile.links.github} target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors">GitHub</a>
      <a href={profile.links.email} class="hover:text-black transition-colors">Email</a>
    </div>
  </div>
</footer>
