---
import profile from '../data/profile.json';
---

<footer class="w-full border-t border-[#eaeaea] mt-24 py-12 bg-white">
  <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-6 text-xs text-[#8a8a93]">
    <div class="flex items-center gap-2">
      <span class="text-[#111113] font-medium">Javier Checa</span>
      <span>—</span>
      <span>Doble Grado en Ingeniería Informática y ADE (UGR)</span>
    </div>

    <div class="flex items-center gap-6">
      <a href="/universidad" class="hover:text-black transition-colors">Grado</a>
      <a href="/proyectos" class="hover:text-black transition-colors">Proyectos</a>
      <a href={profile.links.github} target="_blank" rel="noopener noreferrer" class="hover:text-black transition-colors">GitHub</a>
      <a href={profile.links.email} class="hover:text-black transition-colors">Contacto</a>
    </div>
  </div>
</footer>
