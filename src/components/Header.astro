---
import profile from '../data/profile.json';

interface Props {
  activeTab?: 'home' | 'universidad' | 'proyectos';
}

const { activeTab = 'home' } = Astro.props;
---

<header class="w-full border-b border-[#eaeaea] bg-white sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Identidad izquierda -->
    <a href="/" class="flex items-center gap-3 group">
      <span class="font-semibold text-sm tracking-tight text-[#111113] group-hover:text-black">
        Javier Checa
      </span>
      <span class="text-xs text-[#8a8a93] font-mono hidden sm:inline">
        / Informática & ADE
      </span>
    </a>

    <!-- Las dos subdivisiones solicitadas -->
    <nav class="flex items-center gap-6 text-xs sm:text-sm font-medium">
      <a
        href="/universidad"
        class={`transition-colors py-1 ${activeTab === 'universidad' ? 'text-black border-b border-black font-semibold' : 'text-[#6e6e76] hover:text-black'}`}
      >
        Grado Universitario
      </a>
      <a
        href="/proyectos"
        class={`transition-colors py-1 ${activeTab === 'proyectos' ? 'text-black border-b border-black font-semibold' : 'text-[#6e6e76] hover:text-black'}`}
      >
        Proyectos Personales
      </a>
      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#6e6e76] hover:text-black hidden sm:flex items-center gap-1.5 font-mono text-xs"
      >
        <span>GitHub</span>
        <svg class="w-3 h-3 text-[#9696a0]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </nav>
  </div>
</header>
