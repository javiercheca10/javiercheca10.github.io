---
import profile from '../data/profile.json';

interface Props {
  activeTab?: 'home' | 'universidad' | 'proyectos' | 'sobre-mi';
}

const { activeTab = 'home' } = Astro.props;
---

<header class="w-full border-b border-[#18181b] bg-white sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Brand técnico -->
    <a href="/" class="flex items-center gap-2.5 group">
      <span class="px-1.5 py-0.5 bg-[#18181b] text-white text-xs font-mono font-bold tracking-wider">
        GIIADE
      </span>
      <span class="font-bold text-xs sm:text-sm tracking-tight text-[#09090b] group-hover:underline">
        Recursos & Software · UGR
      </span>
    </a>

    <!-- Enlaces de navegación industrial con indicador deslizante estilo antwi.dev -->
    <nav id="primary-nav" class="nav-tabs-wrap flex items-center gap-3 sm:gap-6 text-xs font-mono h-full">
      <a
        href="/universidad"
        data-nav-tab="universidad"
        class={`nav-tab-link transition-colors py-1 relative ${activeTab === 'universidad' ? 'text-black font-bold is-active' : 'text-[#52525b] hover:text-black'}`}
      >
        [01] Universidad
      </a>
      <a
        href="/proyectos"
        data-nav-tab="proyectos"
        class={`nav-tab-link transition-colors py-1 relative ${activeTab === 'proyectos' ? 'text-black font-bold is-active' : 'text-[#52525b] hover:text-black'}`}
      >
        [02] Proyectos
      </a>
      <a
        href="/sobre-mi"
        data-nav-tab="sobre-mi"
        class={`nav-tab-link transition-colors py-1 relative ${activeTab === 'sobre-mi' ? 'text-black font-bold is-active' : 'text-[#52525b] hover:text-black'}`}
      >
        [03] Sobre mí
      </a>
      <a
        href="/#contacto"
        data-nav-tab="contacto"
        class="nav-tab-link text-[#52525b] hover:text-black hidden sm:inline py-1 relative"
      >
        [04] Contacto
      </a>
      <span id="nav-pill" class="nav-pill-indicator opacity-0" aria-hidden="true"></span>
      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="px-2.5 py-1 border border-[#18181b] bg-white hover:bg-[#18181b] hover:text-white text-[#09090b] text-[11px] font-bold transition-colors flex items-center gap-1.5"
      >
        <span>GitHub</span>
        <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<script>
  function initNavPill() {
    const nav = document.getElementById('primary-nav');
    const pill = document.getElementById('nav-pill');
    if (!nav || !pill) return;

    const links = Array.from(nav.querySelectorAll<HTMLElement>('.nav-tab-link'));
    const activeLink = nav.querySelector<HTMLElement>('.nav-tab-link.is-active');

    function movePillTo(el: HTMLElement | null) {
      if (!el || !nav || !pill) {
        pill?.classList.add('opacity-0');
        return;
      }
      const navRect = nav.getBoundingClientRect();
      const elRect = el.getBoundingClientRect();
      const x = elRect.left - navRect.left;
      const w = elRect.width;
      nav.style.setProperty('--tab-x', `${x}px`);
      nav.style.setProperty('--tab-w', `${w}px`);
      pill.classList.remove('opacity-0');
    }

    movePillTo(activeLink);

    links.forEach((link) => {
      link.addEventListener('pointerenter', () => movePillTo(link));
    });

    nav.addEventListener('pointerleave', () => movePillTo(activeLink));
    window.addEventListener('resize', () => movePillTo(activeLink), { passive: true });
  }

  initNavPill();
  document.addEventListener('astro:page-load', initNavPill);
</script>
