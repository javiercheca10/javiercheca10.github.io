---
import profile from '../data/profile.json';

interface Props {
  activeTab?: 'home' | 'universidad' | 'proyectos' | 'sobre-mi';
}

const { activeTab = 'home' } = Astro.props;
---

<header class="w-full border-b border-[#18181b] bg-white sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- Brand técnico -->
    <a href="/" class="flex items-center gap-2.5 group">
      <span class="px-1.5 py-0.5 bg-[#18181b] text-white text-xs font-mono font-bold tracking-wider">
        GIIADE
      </span>
      <span class="font-bold text-xs sm:text-sm tracking-tight text-[#09090b] group-hover:underline">
        Recursos & Software · UGR
      </span>
    </a>

    <!-- Enlaces de navegación industrial -->
    <nav class="flex items-center gap-3 sm:gap-6 text-xs font-mono">
      <a
        href="/universidad"
        class={`transition-colors py-1 ${activeTab === 'universidad' ? 'text-black font-bold border-b-2 border-black' : 'text-[#52525b] hover:text-black'}`}
      >
        [01] Universidad
      </a>
      <a
        href="/proyectos"
        class={`transition-colors py-1 ${activeTab === 'proyectos' ? 'text-black font-bold border-b-2 border-black' : 'text-[#52525b] hover:text-black'}`}
      >
        [02] Proyectos
      </a>
      <a
        href="/sobre-mi"
        class={`transition-colors py-1 ${activeTab === 'sobre-mi' ? 'text-black font-bold border-b-2 border-black' : 'text-[#52525b] hover:text-black'}`}
      >
        [03] Sobre mí
      </a>
      <a
        href="/#contacto"
        class="text-[#52525b] hover:text-black hidden sm:inline py-1"
      >
        [04] Contacto
      </a>
      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="px-2.5 py-1 border border-[#18181b] bg-white hover:bg-[#18181b] hover:text-white text-[#09090b] text-[11px] font-bold transition-colors flex items-center gap-1.5"
      >
        <span>GitHub</span>
        <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
