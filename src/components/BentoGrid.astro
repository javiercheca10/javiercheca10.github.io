---
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import courses from '../data/courses.json';

const featuredProject = projects.find(p => p.id === 'reparto-radiologia') || projects[0];
const totalSubjects = courses.reduce((acc, c) => acc + c.groups.reduce((gAcc, g) => gAcc + g.subjects.length, 0), 0);
---

<section class="max-w-6xl mx-auto px-4 py-4">
  <!-- Bento Grid Container -->
  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4 auto-rows-[auto]">

    <!-- BENTO 1: Perfil Principal & Hero (Spans 2 cols, 2 rows en desktop) -->
    <div class="md:col-span-2 lg:col-span-2 md:row-span-2 backdrop-blur-xl bg-white/80 dark:bg-[#0c121e]/85 border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 sm:p-8 flex flex-col justify-between shadow-sm hover:border-emerald-500/30 transition-all duration-300 relative overflow-hidden group">
      <!-- Glow decorativo superior -->
      <div class="absolute -top-24 -right-24 w-48 h-48 bg-emerald-500/10 dark:bg-emerald-500/20 rounded-full blur-2xl pointer-events-none group-hover:scale-125 transition-transform duration-700"></div>

      <div>
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-semibold mb-6">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          {profile.status}
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-tight">
          Hola, soy <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 via-teal-500 to-indigo-500">{profile.name}</span>
        </h1>
        
        <p class="mt-2 text-base font-semibold text-emerald-600 dark:text-emerald-400">
          {profile.degree}
        </p>

        <p class="mt-4 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          {profile.bio}
        </p>
      </div>

      <!-- Quick Actions -->
      <div class="mt-8 pt-6 border-t border-slate-200/60 dark:border-slate-800/60 flex flex-wrap items-center gap-3">
        <a
          href="/universidad"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white text-xs sm:text-sm font-semibold shadow-md shadow-emerald-500/20 hover:shadow-emerald-500/30 transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Explorar Asignaturas ({totalSubjects})
        </a>

        <a
          href="/proyectos"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700/70 text-slate-800 dark:text-slate-200 text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-700 transition-all"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          Ver Proyectos
        </a>

        <a
          href={profile.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600 bg-white dark:bg-slate-800/40 text-slate-700 dark:text-slate-300 transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- BENTO 2: Proyecto Estrella / Destacado -->
    <div class="md:col-span-1 lg:col-span-2 backdrop-blur-xl bg-white/80 dark:bg-[#0c121e]/85 border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 sm:p-7 flex flex-col justify-between shadow-sm hover:border-indigo-500/40 transition-all duration-300 relative overflow-hidden group">
      <div class="absolute -top-16 -right-16 w-36 h-36 bg-indigo-500/10 dark:bg-indigo-500/15 rounded-full blur-xl pointer-events-none group-hover:scale-125 transition-transform duration-500"></div>

      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="px-2.5 py-1 rounded-md bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-xs font-semibold">
            Proyecto Destacado
          </span>
          <span class="text-xs text-slate-700 dark:text-slate-300 font-mono">
            {featuredProject.badge}
          </span>
        </div>

        <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-500 dark:group-hover:text-indigo-400 transition-colors">
          {featuredProject.title}
        </h3>
        <p class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">
          {featuredProject.subtitle}
        </p>

        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-3 leading-relaxed">
          {featuredProject.description}
        </p>
      </div>

      <div class="mt-5 pt-4 border-t border-slate-200/60 dark:border-slate-800/60 flex items-center justify-between">
        <div class="flex flex-wrap gap-1.5">
          {featuredProject.tags.slice(0, 3).map(tag => (
            <span class="px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800/60 text-slate-600 dark:text-slate-300 text-[11px] font-mono">
              {tag}
            </span>
          ))}
        </div>
        <a
          href="/proyectos"
          class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline flex items-center gap-1"
        >
          Detalles
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- BENTO 3: Doble Grado & Asignaturas UGR (Navegación Rápida) -->
    <div class="md:col-span-1 lg:col-span-2 backdrop-blur-xl bg-white/80 dark:bg-[#0c121e]/85 border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 sm:p-7 flex flex-col justify-between shadow-sm hover:border-emerald-500/40 transition-all duration-300 relative overflow-hidden group">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
            Plan de Estudios Oficial
          </span>
          <span class="text-xs text-slate-700 dark:text-slate-300 font-mono">
            UGR · ETSIIT & FCEE
          </span>
        </div>

        <h3 class="text-xl font-bold text-slate-900 dark:text-white">
          5 Cursos · {totalSubjects} Asignaturas
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2">
          Catálogo íntegro del doble grado con guías docentes de la Universidad de Granada, apuntes y recursos.
        </p>

        <!-- Píldoras de cursos -->
        <div class="grid grid-cols-5 gap-2 mt-4">
          {courses.map(c => (
            <a
              href={`/universidad?curso=${c.year}`}
              class="flex flex-col items-center justify-center p-2 rounded-xl bg-slate-100/80 dark:bg-slate-800/50 hover:bg-emerald-500/10 hover:border-emerald-500/40 border border-slate-200/60 dark:border-slate-800 text-center transition-all group/item"
            >
              <span class="text-xs font-bold text-slate-800 dark:text-slate-200 group-hover/item:text-emerald-500">
                {c.year}º
              </span>
              <span class="text-[10px] text-slate-700 dark:text-slate-300 font-mono">
                {c.groups.reduce((acc, g) => acc + g.subjects.length, 0)} asig
              </span>
            </a>
          ))}
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-slate-800/60 flex items-center justify-between">
        <span class="text-xs text-slate-700 dark:text-slate-300">
          Semestres 1 y 2 por cada año
        </span>
        <a
          href="/universidad"
          class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1"
        >
          Ver todo el plan
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>

    <!-- BENTO 4: Habilidades Tech (Informática) -->
    <div id="skills" class="md:col-span-1 lg:col-span-2 backdrop-blur-xl bg-white/80 dark:bg-[#0c121e]/85 border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 sm:p-7 flex flex-col justify-between shadow-sm hover:border-teal-500/30 transition-all">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <div class="w-2 h-2 rounded-full bg-teal-500"></div>
          <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">
            Ingeniería del Software & Sistemas
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-4">
          Lenguajes de programación, herramientas de desarrollo, librerías de optimización y entornos operativos.
        </p>

        <div class="flex flex-wrap gap-2">
          {profile.skills.dev.map(skill => (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 text-slate-700 dark:text-slate-200 text-xs font-medium font-mono hover:border-teal-500/50 hover:text-teal-500 transition-colors">
              {skill}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- BENTO 5: Habilidades Business & ADE -->
    <div class="md:col-span-1 lg:col-span-2 backdrop-blur-xl bg-white/80 dark:bg-[#0c121e]/85 border border-slate-200/80 dark:border-slate-800/80 rounded-3xl p-6 sm:p-7 flex flex-col justify-between shadow-sm hover:border-amber-500/30 transition-all">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <div class="w-2 h-2 rounded-full bg-amber-500"></div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
            Administración & Dirección de Empresas
          </span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-4">
          Estrategia corporativa y de operaciones, análisis financiero, costes, toma de decisiones y econometría.
        </p>

        <div class="flex flex-wrap gap-2">
          {profile.skills.business.map(skill => (
            <span class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/60 border border-slate-200/60 dark:border-slate-700/60 text-slate-700 dark:text-slate-200 text-xs font-medium font-mono hover:border-amber-500/50 hover:text-amber-500 transition-colors">
              {skill}
            </span>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>
