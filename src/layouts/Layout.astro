---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ScrollScene3D from '../components/ScrollScene3D.astro';

interface Props {
  title?: string;
  description?: string;
  show3d?: boolean;
}

const {
  title = "Recursos & Software · Doble Grado en Informática y ADE | UGR",
  description = "Plataforma de recursos académicos, guías docentes, software de optimización y proyectos del Doble Grado en Informática y ADE (UGR).",
  show3d = false
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-[#fbfbfb] text-[#09090b]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Javier Checa" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://javiercheca.github.io/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Tipografías técnicas e industriales: Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Transiciones de página fluidas estilo antwi.dev (sin animación de texto inicial) -->
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-[#fbfbfb] text-[#09090b] font-['Inter',sans-serif] antialiased relative">
    <!-- Escena 3D de fondo guiada por scroll: solo activa en la página principal -->
    {show3d && <ScrollScene3D />}

    <!-- Contenido principal -->
    <div class="relative z-10" style="view-transition-name: page-main;">
      <slot />
    </div>
  </body>
</html>
