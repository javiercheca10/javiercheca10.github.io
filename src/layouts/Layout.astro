---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Javier Checa | Portfolio & Recursos GIIADE UGR",
  description = "Portfolio personal y recursos del Doble Grado en Ingeniería Informática y ADE en la Universidad de Granada. Proyectos de software, apuntes, optimización y estrategia."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Javier Checa" />
    
    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://javiercheca10.github.io/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Tipografías de alta legibilidad -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Script de inicialización de tema antes de renderizar para evitar flash -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'dark'; // Dark mode por defecto para estética Bento elegante
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800 dark:bg-[#070a11] dark:text-slate-100 font-['Plus_Jakarta_Sans',sans-serif] selection:bg-emerald-500/20 selection:text-emerald-500 transition-colors duration-200">
    <!-- Efecto de iluminación ambiental de fondo -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-emerald-500/10 dark:bg-emerald-500/15 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -right-40 w-[30rem] h-[30rem] bg-indigo-500/10 dark:bg-indigo-500/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 left-1/3 w-96 h-96 bg-amber-500/10 dark:bg-amber-500/5 rounded-full blur-3xl"></div>
    </div>

    <slot />
  </body>
</html>

<style is:global>
  ::selection {
    background-color: rgba(16, 185, 129, 0.25);
    color: inherit;
  }
</style>
