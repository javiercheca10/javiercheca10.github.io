---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Javier Checa — Informática & ADE",
  description = "Portfolio personal y recursos del Doble Grado en Ingeniería Informática y ADE (UGR). Proyectos de software, optimización y trayectoria académica."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-white text-[#111113]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Javier Checa" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://javiercheca10.github.io/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Tipografías editoriales estilo Daniel Sun: Inter + EB Garamond Italic + Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@1,400;1,500;1,600&family=Geist+Mono:wght@400;500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-white text-[#111113] font-['Inter',sans-serif] antialiased">
    <slot />
  </body>
</html>
